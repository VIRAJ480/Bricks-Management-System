                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Labour" && ViewContext.RouteData.Values["action"]?.ToString() == "Salary" ? "active" : "")"
                   href="/SalaryPayment/Index">
                    <span class="nav-icon">💳</span>
                    <span class="nav-label" data-i18n="nav.salaryPayment">Salary Payment</span>
                </a>
                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "LabourLedgerReport" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                   href="/LabourLedgerReport/Index">
