                   href="/MaterialPurchase/Index">
                    <span class="nav-icon">🛒</span>
                    <span class="nav-label" data-i18n="nav.materialPurchase">Material Purchase</span>
                </a>
                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Vendor Payment" ? "active" : "")"
                   href="/VendorPayment/Index">
