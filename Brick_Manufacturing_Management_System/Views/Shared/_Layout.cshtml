<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Jyotirling Bricks Suppliers</title>
    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&family=Nunito:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        import url('d:\bricks factory\brick_manufacturing_management_system\brick_manufacturing_management_system\views\shared\_layout.cshtml.css');
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --bg-dark: #0d1117;
            --bg-sidebar: #0d1117;
            --bg-card: #161b22;
            --bg-hover: #1c2128;
            --bg-active: rgba(224,123,57,0.12);
            --accent: #e07b39;
            --accent2: #f0a060;
            --accent-dim: rgba(224,123,57,0.18);
            --text-pri: #e6edf3;
            --text-sec: #8b949e;
            --text-dim: #484f58;
            --border: rgba(255,255,255,0.07);
            --border-acc: rgba(224,123,57,0.4);
            --topbar-h: 60px;
            --sidebar-w: 240px;
            --sidebar-col: rgba(224,123,57,0.55);
        }

        html, body {
            height: 100%;
            background: var(--bg-dark);
            font-family: 'Nunito', sans-serif;
            color: var(--text-pri);
            overflow: hidden;
        }

        /* ── TOPBAR ── */
        .topbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;
            height: var(--topbar-h);
            background: var(--bg-sidebar);
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 20px 0 0;
        }

        .topbar-brand {
            width: var(--sidebar-w);
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 16px;
            border-right: 1px solid var(--border);
            height: 100%;
            flex-shrink: 0;
        }

        .brand-icon {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, #e07b39, #b85a1e);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            box-shadow: 0 2px 12px rgba(224,123,57,0.35);
        }

        .brand-name {
            font-family: 'Rajdhani', sans-serif;
            font-size: 15px;
            font-weight: 700;
            letter-spacing: 0.5px;
            line-height: 1.1;
            color: var(--text-pri);
        }

            .brand-name small {
                display: block;
                font-size: 9px;
                font-weight: 500;
                letter-spacing: 2px;
                color: var(--accent);
                text-transform: uppercase;
            }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .stat-chip {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            padding: 4px 14px;
            border-right: 1px solid var(--border);
        }

            .stat-chip .val {
                font-family: 'Rajdhani', sans-serif;
                font-size: 18px;
                font-weight: 700;
                color: var(--accent);
                line-height: 1;
            }

            .stat-chip .lbl {
                font-size: 9px;
                font-weight: 600;
                letter-spacing: 1.5px;
                text-transform: uppercase;
                color: var(--text-sec);
                margin-top: 2px;
            }

        .topbar-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: linear-gradient(135deg, #e07b39, #7c3510);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            font-weight: 700;
            color: #fff;
            cursor: pointer;
            margin-left: 6px;
        }

        .btn-logout {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 7px 14px;
            background: rgba(248,81,73,0.1);
            border: 1px solid rgba(248,81,73,0.25);
            border-radius: 8px;
            color: #f85149;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            transition: background .2s;
        }

            .btn-logout:hover {
                background: rgba(248,81,73,0.2);
            }

        .lang-selector {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 0 14px;
            border-right: 1px solid var(--border);
        }

            .lang-selector label {
                font-size: 11px;
                font-weight: 600;
                color: var(--text-sec);
                white-space: nowrap;
            }

            .lang-selector select {
                background: var(--bg-hover);
                border: 1px solid var(--border-acc);
                border-radius: 6px;
                color: var(--text-pri);
                font-size: 12px;
                font-weight: 600;
                padding: 4px 8px;
                cursor: pointer;
                outline: none;
            }

            .lang-selector select:hover {
                border-color: var(--accent);
            }

        /* ── SIDEBAR ── */
        .sidebar {
            position: fixed;
            top: var(--topbar-h);
            left: 0;
            bottom: 0;
            width: var(--sidebar-w);
            z-index: 90;
            background: var(--bg-sidebar);
            border-right: 1px solid var(--border);
            overflow-y: auto;
            overflow-x: hidden;
            scrollbar-width: thin;
            scrollbar-color: var(--border) transparent;
        }

            .sidebar::-webkit-scrollbar {
                width: 4px;
            }

            .sidebar::-webkit-scrollbar-thumb {
                background: var(--border);
                border-radius: 2px;
            }

        .sidebar-inner {
            padding: 12px 0 20px;
        }

        /* nav group */
        .nav-group {
            margin-bottom: 6px;
        }

        .nav-group-label {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--text-dim);
            padding: 14px 18px 6px;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 18px;
            font-size: 13px;
            font-weight: 500;
            color: var(--text-sec);
            text-decoration: none;
            cursor: pointer;
            border-radius: 0;
            transition: background .15s, color .15s;
            border-left: 3px solid transparent;
            position: relative;
        }

            .nav-item:hover {
                background: var(--bg-hover);
                color: var(--text-pri);
            }

            .nav-item.active {
                background: var(--bg-active);
                color: var(--accent);
                border-left-color: var(--accent);
                font-weight: 600;
            }

            .nav-item .nav-icon {
                font-size: 15px;
                width: 20px;
                text-align: center;
                flex-shrink: 0;
            }

            .nav-item .nav-label {
                flex: 1;
            }

        .nav-badge {
            font-size: 10px;
            font-weight: 700;
            background: var(--accent-dim);
            color: var(--accent);
            border-radius: 99px;
            padding: 1px 7px;
        }

        /* ── MAIN CONTENT ── */
        .main-content {
            margin-left: var(--sidebar-w);
            margin-top: var(--topbar-h);
            height: calc(100vh - var(--topbar-h));
            overflow-y: auto;
            padding: 24px;
            scrollbar-width: thin;
            scrollbar-color: var(--border) transparent;
        }

            .main-content::-webkit-scrollbar {
                width: 6px;
            }

            .main-content::-webkit-scrollbar-thumb {
                background: var(--border);
                border-radius: 3px;
            }

        /* page header */
        .page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
        }

        .page-title {
            font-family: 'Rajdhani', sans-serif;
            font-size: 22px;
            font-weight: 700;
            color: var(--text-pri);
        }

        .page-breadcrumb {
            font-size: 12px;
            color: var(--text-sec);
            margin-top: 2px;
        }

            .page-breadcrumb span {
                color: var(--accent);
            }

        /* cards */
        .card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 20px;
        }

        /* stat cards row */
        .stats-row {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
            gap: 12px;
            margin-bottom: 24px;
        }

        .stat-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 16px;
            position: relative;
            overflow: hidden;
        }

            .stat-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 2px;
                background: linear-gradient(90deg, var(--accent), transparent);
            }

            .stat-card .sc-label {
                font-size: 11px;
                font-weight: 600;
                letter-spacing: 1px;
                text-transform: uppercase;
                color: var(--text-sec);
                margin-bottom: 6px;
            }

            .stat-card .sc-value {
                font-family: 'Rajdhani', sans-serif;
                font-size: 26px;
                font-weight: 700;
                color: var(--text-pri);
            }

            .stat-card .sc-sub {
                font-size: 11px;
                color: var(--text-sec);
                margin-top: 2px;
            }

        /* mobile toggle */
        .sidebar-toggle {
            display: none;
            background: none;
            border: none;
            cursor: pointer;
            color: var(--text-pri);
            font-size: 20px;
            padding: 4px 12px;
        }

        media (max-width: 768px) {
            .sidebar

        {
            transform: translateX(-100%);
            transition: transform .25s ease;
        }

        .sidebar.open {
            transform: translateX(0);
        }

        .main-content {
            margin-left: 0;
        }

        .sidebar-toggle {
            display: block;
        }

        .stat-chip {
            display: none;
        }

        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>


    <!-- ── TOPBAR ── -->
    <header class="topbar">
        <div class="topbar-brand">
            <div class="brand-icon">🧱</div>
            <div class="brand-name">
                <span data-i18n="brand.name">Jyotirling</span>
                <small data-i18n="brand.sub">Bricks Suppliers</small>
            </div>
        </div>

        <button class="sidebar-toggle" onclick="toggleSidebar()">☰</button>

        <div class="topbar-right">
            @* <div class="stat-chip">
                <span class="val" id="statLabour">—</span>
                <span class="lbl" data-i18n="topbar.activeLabour">Active Labour</span>
            </div>
            <div class="stat-chip">
                <span class="val" id="statProduction">—</span>
                <span class="lbl" data-i18n="topbar.todayBricks">Today's Bricks</span>
            </div>
            <div class="stat-chip">
                <span class="val" id="statPending">—</span>
                <span class="lbl" data-i18n="topbar.pendingAmt">Pending Amt</span>
            </div> *@

            <div class="lang-selector">
                <label data-i18n="lang.label">🌐 Language</label>
                <select id="langDropdown" onchange="changeLanguage(this.value)">
                    <option value="en">English</option>
                    <option value="mr">मराठी</option>
                </select>
            </div>

            <div class="topbar-avatar" title="@(Context.Session.GetString("Username") ?? "Admin")">
                @((Context.Session.GetString("Username") ?? "A").Substring(0, 1).ToUpper())
            </div>

            <a href="/Login/Logout" class="btn-logout" data-i18n="topbar.logout">↩ Logout</a>
        </div>
    </header>

    <!-- ── SIDEBAR ── -->
    <nav class="sidebar" id="sidebar">
        <div class="sidebar-inner">

            <!-- OVERVIEW -->
            <div class="nav-group">
                <div class="nav-group-label" data-i18n="nav.overview">Overview</div>
                <a class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")"
                   href="/Login/Dashboard">
                    <span class="nav-icon">📊</span>
                    <span class="nav-label" data-i18n="nav.dashboard">Dashboard</span>
                </a>
            </div>

            <!-- VENDOR & MATERIAL -->
            <div class="nav-group">
                <div class="nav-group-label" data-i18n="nav.vendorMat">Vendors & Materials</div>
                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Vendor" ? "active" : "")"
                   href="/Vendor/Index">
                    <span class="nav-icon">🏪</span>
                    <span class="nav-label" data-i18n="nav.vendorMaster">Vendor Master</span>
                </a>
                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Material" ? "active" : "")"
                   href="/Material/Index">
                    <span class="nav-icon">📦</span>
                    <span class="nav-label" data-i18n="nav.materialMaster">Material Master</span>
                </a>
                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Purchase" ? "active" : "")"
                   href="/MaterialPurchase/Index">
                    <span class="nav-icon">🛒</span>
                    <span class="nav-label" data-i18n="nav.materialPurchase">Material Purchase</span>
                </a>
                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Vendor Payment" ? "active" : "")"
                   href="/VendorPayment/Index">
                    <span class="nav-icon">🛒</span>
                    <span class="nav-label" data-i18n="nav.VendorPayment">Vendor Payment</span>
                </a>
            </div>

            <!-- LABOUR -->
            <div class="nav-group">
                <div class="nav-group-label" data-i18n="nav.labour">Labour Management</div>
                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Labour" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                   href="/LabourMaster/Index">
                    <span class="nav-icon">👷</span>
                    <span class="nav-label" data-i18n="nav.labourMaster">Labour Master</span>
                </a>
                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Labour" && ViewContext.RouteData.Values["action"]?.ToString() == "Advance" ? "active" : "")"
                   href="/LabourAdvance/Index">
                    <span class="nav-icon">💰</span>
                    <span class="nav-label" data-i18n="nav.labourAdvance">Labour Advance</span>
                </a>
                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Labour" && ViewContext.RouteData.Values["action"]?.ToString() == "Work" ? "active" : "")"
                   href="/LabourWork/Index">
                    <span class="nav-icon">📅</span>
                    <span class="nav-label" data-i18n="nav.workEntry">Work Entry</span>
                </a>
                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Labour" && ViewContext.RouteData.Values["action"]?.ToString() == "Expense" ? "active" : "")"
                   href="/LabourExpense/Index">
                    <span class="nav-icon">🧾</span>
                    <span class="nav-label" data-i18n="nav.labourExpense">Labour Expense</span>
                </a>
                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Labour" && ViewContext.RouteData.Values["action"]?.ToString() == "Deduction" ? "active" : "")"
                   href="/AdvanceDeduction/Index">
                    <span class="nav-icon">➖</span>
                    <span class="nav-label" data-i18n="nav.advDeduction">Advance Deduction</span>
                </a>
                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Labour" && ViewContext.RouteData.Values["action"]?.ToString() == "Salary" ? "active" : "")"
                   href="/SalaryPayment/Index">
                    <span class="nav-icon">💳</span>
                    <span class="nav-label" data-i18n="nav.salaryPayment">Salary Payment</span>
                </a>
                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "LabourLedgerReport" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                   href="/LabourLedgerReport/Index">
                    <span class="nav-icon">📊</span>
                    <span class="nav-label" data-i18n="nav.labourLedger">Labour Ledger Report</span>
                </a>
            </div>

            <!-- PRODUCTION -->
            <div class="nav-group">
                <div class="nav-group-label" data-i18n="nav.production">Production</div>
                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Production" ? "active" : "")"
                   href="/BrickProduction/Index">
                    <span class="nav-icon">🏭</span>
                    <span class="nav-label" data-i18n="nav.brickProduction">Brick Production</span>
                </a>
            </div>

            <!-- SALES -->
            <div class="nav-group">
                <div class="nav-group-label" data-i18n="nav.sales">Sales & Payments</div>
                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Customer" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                   href="/CustomerMaster/Index">
                    <span class="nav-icon">👥</span>
                    <span class="nav-label" data-i18n="nav.customerMaster">Customer Master</span>
                </a>
                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Sales" ? "active" : "")"
                   href="/BrickSales/Index">
                    <span class="nav-icon">🧱</span>
                    <span class="nav-label" data-i18n="nav.brickSales">Brick Sales</span>
                </a>
                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Customer" && ViewContext.RouteData.Values["action"]?.ToString() == "Payment" ? "active" : "")"
                   href="/CustomerPayment/Index">
                    <span class="nav-icon">📥</span>
                    <span class="nav-label" data-i18n="nav.customerPayment">Customer Payment</span>
                    <span class="nav-badge" id="pendingBadge">—</span>
                </a>
            </div>

            <!-- REPORTS -->
            <div class="nav-group">
                <div class="nav-group-label" data-i18n="nav.reports">Reports</div>
                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Report" && ViewContext.RouteData.Values["action"]?.ToString() == "Material" ? "active" : "")"
                   href="/MaterialReport/Index">
                    <span class="nav-icon">📋</span>
                    <span class="nav-label" data-i18n="nav.materialReport">Material Report</span>
                </a>
                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Report" && ViewContext.RouteData.Values["action"]?.ToString() == "Labour" ? "active" : "")"
                   href="/Report/Labour">
                    <span class="nav-icon">👷</span>
                    <span class="nav-label" data-i18n="nav.labourReport">Labour Report</span>
                </a>
                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Report" && ViewContext.RouteData.Values["action"]?.ToString() == "Production" ? "active" : "")"
                   href="/Report/Production">
                    <span class="nav-icon">🏭</span>
                    <span class="nav-label" data-i18n="nav.productionReport">Production Report</span>
                </a>
                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Report" && ViewContext.RouteData.Values["action"]?.ToString() == "Sales" ? "active" : "")"
                   href="/SalesReport/Index">
                    <span class="nav-icon">📈</span>
                    <span class="nav-label" data-i18n="nav.salesReport">Sales Report</span>
                </a>
                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Report" && ViewContext.RouteData.Values["action"]?.ToString() == "Pending" ? "active" : "")"
                   href="/PendingPaymentReport/Index">
                    <span class="nav-icon">⏳</span>
                    <span class="nav-label" data-i18n="nav.pendingPayments">Customer Pending Payments</span>
                </a>
                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Report" && ViewContext.RouteData.Values["action"]?.ToString() == "Pending" ? "active" : "")"
                   href="/VendorPendingPaymentReport/Index">
                    <span class="nav-icon">⏳</span>
                    <span class="nav-label" data-i18n="nav.VendorPendingPaymentReport">Vendor Pending Payments</span>
                </a>
            </div>

            <!-- SYSTEM -->
            <div class="nav-group">
                <div class="nav-group-label" data-i18n="nav.system">System</div>
                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Account" ? "active" : "")"
                   href="/Account/Index">
                    <span class="nav-icon">⚙️</span>
                    <span class="nav-label" data-i18n="nav.accountSettings">Account Settings</span>
                </a>
            </div>

        </div>
    </nav>

    <!-- ── MAIN CONTENT ── -->
    <main class="main-content">
        @RenderBody()
    </main>

    <!-- Toast notification slot -->
    @if (TempData["Success"] != null)
    {
        <div id="toast" style="position:fixed;bottom:24px;right:24px;z-index:999;background:#161b22;border:1px solid rgba(63,185,80,0.4);border-radius:10px;padding:12px 18px;font-size:13px;color:#3fb950;display:flex;align-items:flex-start;gap:8px;box-shadow:0 8px 24px rgba(0,0,0,0.4);max-width:420px;word-break:break-word;line-height:1.5;">
            ✅ @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div id="toast" style="position:fixed;bottom:24px;right:24px;z-index:999;background:#161b22;border:1px solid rgba(248,81,73,0.4);border-radius:10px;padding:12px 18px;font-size:13px;color:#f85149;display:flex;align-items:flex-start;gap:8px;box-shadow:0 8px 24px rgba(0,0,0,0.4);max-width:420px;word-break:break-word;line-height:1.5;">
            ⚠️ @TempData["Error"]
        </div>
    }

    <script>
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('open');
        }

        // auto-dismiss toast
        const toast = document.getElementById('toast');
        if (toast) setTimeout(() => {
            toast.style.transition = 'opacity .5s';
            toast.style.opacity = '0';
            setTimeout(() => toast.remove(), 500);
        }, 3500);
    </script>

    <script src="~/js/i18n.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
