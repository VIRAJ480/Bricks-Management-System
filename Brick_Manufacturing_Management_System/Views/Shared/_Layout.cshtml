<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Jyotirling Brick Suppliers – Late Tanajirao Mane Brick Industry Group </title>
    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&family=Nunito:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        import url('d:\bricks factory\brick_manufacturing_management_system\brick_manufacturing_management_system\views\shared\_layout.cshtml.css');
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --bg-dark: #0d1117;
            --bg-sidebar: #0d1117;
            --bg-card: #161b22;
            --bg-hover: #1c2128;
            --bg-active: rgba(224,123,57,0.12);
            --accent: #e07b39;
            --accent2: #f0a060;
            --accent-dim: rgba(224,123,57,0.18);
            --text-pri: #e6edf3;
            --text-sec: #8b949e;
            --text-dim: #484f58;
            --border: rgba(255,255,255,0.07);
            --border-acc: rgba(224,123,57,0.4);
            --topbar-h: 60px;
            --sidebar-w: 240px;
            --sidebar-col: rgba(224,123,57,0.55);
        }

        html, body {
            height: 100%;
            background: var(--bg-dark);
            font-family: 'Nunito', sans-serif;
            color: var(--text-pri);
            overflow: hidden;
        }

        /* ── TOPBAR ── */
        .topbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 100;
            height: var(--topbar-h);
            background: var(--bg-sidebar);
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 20px 0 0;
        }

        .topbar-brand {
            width: var(--sidebar-w);
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 16px;
            border-right: 1px solid var(--border);
            height: 100%;
            flex-shrink: 0;
        }

        .brand-icon {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, #e07b39, #b85a1e);
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            box-shadow: 0 2px 12px rgba(224,123,57,0.35);
        }

        .brand-name {
            font-family: 'Rajdhani', sans-serif;
            font-size: 15px;
            font-weight: 700;
            letter-spacing: 0.5px;
            line-height: 1.1;
            color: var(--text-pri);
        }

            .brand-name small {
                display: block;
                font-size: 9px;
                font-weight: 500;
                letter-spacing: 2px;
                color: var(--accent);
                text-transform: uppercase;
            }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .stat-chip {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            padding: 4px 14px;
            border-right: 1px solid var(--border);
        }

            .stat-chip .val {
                font-family: 'Rajdhani', sans-serif;
                font-size: 18px;
                font-weight: 700;
                color: var(--accent);
                line-height: 1;
            }

            .stat-chip .lbl {
                font-size: 9px;
                font-weight: 600;
                letter-spacing: 1.5px;
                text-transform: uppercase;
                color: var(--text-sec);
                margin-top: 2px;
            }

        .topbar-avatar {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            background: linear-gradient(135deg, #e07b39, #7c3510);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            font-weight: 700;
            color: #fff;
            cursor: pointer;
            margin-left: 6px;
        }

        .btn-logout {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 7px 14px;
            background: rgba(248,81,73,0.1);
            border: 1px solid rgba(248,81,73,0.25);
            border-radius: 8px;
            color: #f85149;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            transition: background .2s;
        }

            .btn-logout:hover {
                background: rgba(248,81,73,0.2);
            }

        .lang-selector {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 0 14px;
            border-right: 1px solid var(--border);
        }

            .lang-selector label {
                font-size: 11px;
                font-weight: 600;
                color: var(--text-sec);
                white-space: nowrap;
            }

            .lang-selector select {
                background: var(--bg-hover);
                border: 1px solid var(--border-acc);
                border-radius: 6px;
                color: var(--text-pri);
                font-size: 12px;
                font-weight: 600;
                padding: 4px 8px;
                cursor: pointer;
                outline: none;
            }

            .lang-selector select:hover {
                border-color: var(--accent);
            }

        /* ── SIDEBAR ── */
        .sidebar {
            position: fixed;
            top: var(--topbar-h);
            left: 0;
            bottom: 0;
            width: var(--sidebar-w);
            z-index: 90;
            background: var(--bg-sidebar);
            border-right: 1px solid var(--border);
            overflow-y: auto;
            overflow-x: hidden;
            scrollbar-width: thin;
            scrollbar-color: var(--border) transparent;
            transition: transform .28s cubic-bezier(.4,0,.2,1), box-shadow .28s ease;
        }

        .sidebar::-webkit-scrollbar { width: 3px; }
        .sidebar::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

        .sidebar-inner { padding: 10px 8px 24px; }

        /* ── nav group label ── */
        .nav-group { margin-bottom: 4px; }

        .nav-group-label {
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 1.8px;
            text-transform: uppercase;
            color: #ffffff;
            padding: 16px 12px 6px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .nav-group-label::after {
            content: '';
            flex: 1;
            height: 1px;
            background: var(--border);
            margin-left: 4px;
        }

        /* ── nav item ── */
        .nav-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 12px;
            margin: 2px 0;
            font-size: 13px;
            font-weight: 500;
            color: var(--text-sec);
            text-decoration: none;
            cursor: pointer;
            border-radius: 10px;
            border: 1px solid transparent;
            position: relative;
            transition: background .18s ease,
                        color .18s ease,
                        border-color .18s ease,
                        transform .2s cubic-bezier(.34,1.56,.64,1),
                        box-shadow .18s ease;
            overflow: hidden;
        }

        /* shimmer sweep on hover */
        .nav-item::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, transparent 0%, rgba(224,123,57,.06) 50%, transparent 100%);
            transform: translateX(-100%);
            transition: transform .4s ease;
            pointer-events: none;
            border-radius: 10px;
        }

        .nav-item:hover::before { transform: translateX(100%); }

        .nav-item:hover {
            background: var(--bg-hover);
            color: var(--text-pri);
            border-color: var(--border);
            transform: translateX(4px);
            box-shadow: 2px 0 12px rgba(0,0,0,.25);
        }

        .nav-item:active { transform: translateX(2px) scale(.98); }

        /* active state */
        .nav-item.active {
            background: rgba(224,123,57,.13);
            color: var(--accent);
            border-color: rgba(224,123,57,.28);
            font-weight: 700;
            box-shadow: inset 3px 0 0 var(--accent), 0 2px 12px rgba(224,123,57,.12);
        }

        .nav-item.active::before { display: none; }

        /* icon */
        .nav-item .nav-icon {
            font-size: 16px;
            width: 28px;
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 7px;
            flex-shrink: 0;
            transition: transform .22s cubic-bezier(.34,1.56,.64,1), background .18s;
        }

        .nav-item:hover .nav-icon  { transform: rotate(-8deg) scale(1.18); background: rgba(224,123,57,.1); }
        .nav-item.active .nav-icon { background: rgba(224,123,57,.15); }

        .nav-item .nav-label { flex: 1; line-height: 1.2; }

        .nav-badge {
            font-size: 10px;
            font-weight: 700;
            background: var(--accent-dim);
            color: var(--accent);
            border-radius: 99px;
            padding: 2px 8px;
            flex-shrink: 0;
        }

        /* ── mobile overlay backdrop ── */
        .sidebar-backdrop {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.55);
            z-index: 89;
            backdrop-filter: blur(2px);
        }

        .sidebar-backdrop.show { display: block; }

        /* mobile toggle */
        .sidebar-toggle {
            display: none;
            background: none;
            border: 1px solid var(--border);
            border-radius: 8px;
            cursor: pointer;
            color: var(--text-pri);
            font-size: 18px;
            padding: 5px 10px;
            transition: border-color .2s, background .2s;
            margin-left: 12px;
        }

        .sidebar-toggle:hover { border-color: var(--accent); background: rgba(224,123,57,.08); }

        /* ── MAIN CONTENT ── */
        .main-content {
            margin-left: var(--sidebar-w);
            margin-top: var(--topbar-h);
            height: calc(100vh - var(--topbar-h));
            overflow-y: auto;
            padding: 24px;
            scrollbar-width: thin;
            scrollbar-color: var(--border) transparent;
            transition: margin-left .28s ease;
        }

        .main-content::-webkit-scrollbar { width: 6px; }
        .main-content::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }

        /* page header */
        .page-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:24px; }
        .page-title { font-family:'Rajdhani',sans-serif; font-size:22px; font-weight:700; color:var(--text-pri); }
        .page-breadcrumb { font-size:12px; color:var(--text-sec); margin-top:2px; }
        .page-breadcrumb span { color:var(--accent); }

        .card { background:var(--bg-card); border:1px solid var(--border); border-radius:12px; padding:20px; }

        .stats-row { display:grid; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); gap:12px; margin-bottom:24px; }
        .stat-card { background:var(--bg-card); border:1px solid var(--border); border-radius:10px; padding:16px; position:relative; overflow:hidden; }
        .stat-card::before { content:''; position:absolute; top:0; left:0; right:0; height:2px; background:linear-gradient(90deg,var(--accent),transparent); }
        .stat-card .sc-label { font-size:11px; font-weight:600; letter-spacing:1px; text-transform:uppercase; color:var(--text-sec); margin-bottom:6px; }
        .stat-card .sc-value { font-family:'Rajdhani',sans-serif; font-size:26px; font-weight:700; color:var(--text-pri); }
        .stat-card .sc-sub { font-size:11px; color:var(--text-sec); margin-top:2px; }

        /* ── RESPONSIVE ── */
        @@media (max-width: 768px) {
            .sidebar {
                transform: translateX(-100%);
                box-shadow: none;
            }

            .sidebar.open {
                transform: translateX(0);
                box-shadow: 8px 0 32px rgba(0,0,0,.5);
            }

            .main-content {
                margin-left: 0;
            }

            .sidebar-toggle {
                display: block;
            }

            .stat-chip {
                display: none;
            }

            .lang-selector label {
                display: none;
            }
        }

        /* ── LOGOUT CONFIRMATION MODAL ── */
        .logout-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.6);
            backdrop-filter: blur(3px);
            z-index: 600;
            align-items: center;
            justify-content: center;
        }

            .logout-overlay.show {
                display: flex;
            }

        .logout-box {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 28px 26px 22px;
            width: 360px;
            max-width: 90vw;
            text-align: center;
            box-shadow: 0 24px 60px rgba(0,0,0,.55);
            animation: lgPop .22s ease;
        }

        @@keyframes lgPop {
            from { transform: scale(.9); opacity: 0; }
            to   { transform: scale(1); opacity: 1; }
        }

        .logout-icon {
            font-size: 40px;
            margin-bottom: 8px;
        }

        .logout-box h3 {
            font-family: 'Rajdhani', sans-serif;
            font-size: 22px;
            font-weight: 700;
            color: var(--text-pri);
            margin: 0 0 6px;
        }

        .logout-box p {
            font-size: 13px;
            color: var(--text-sec);
            line-height: 1.5;
            margin: 0 0 20px;
        }

        .logout-footer {
            display: flex;
            gap: 10px;
            justify-content: center;
        }

        .lg-btn {
            flex: 1;
            padding: 10px 16px;
            border-radius: 9px;
            font-size: 13px;
            font-weight: 700;
            font-family: 'Nunito', sans-serif;
            cursor: pointer;
            text-decoration: none;
            text-align: center;
            transition: all .18s;
            border: 1px solid var(--border);
        }

        .lg-btn-cancel {
            background: rgba(255,255,255,.05);
            color: var(--text-sec);
        }

            .lg-btn-cancel:hover {
                border-color: var(--text-sec);
                color: var(--text-pri);
            }

        .lg-btn-confirm {
            background: rgba(248,81,73,.15);
            color: #f85149;
            border-color: rgba(248,81,73,.35);
        }

            .lg-btn-confirm:hover {
                background: rgba(248,81,73,.28);
            }
    </style>
    @await RenderSectionAsync("Styles", required: false)
    <style>
        /* ══ GLOBAL LEGIBILITY BOOST ══
           Brighten & enlarge the small faint labels across every form/page.
           Scoped to @@media screen so it never overrides print color rules. */
        @@media screen {

            /* Form field labels (Vendor Name *, Mobile Number *, GST Number, Address, Status …) */
            .fg label,
            .form-group > label {
                color: #e6edf3 !important;
                font-size: 11.5px !important;
            }

            /* Table column headers (VENDOR, MOBILE, GST NUMBER, ADDRESS, STATUS, ACTIONS …) */
            thead th {
                color: #d7dee6 !important;
                font-size: 11px !important;
            }

            /* Summary chips / stat labels (Total, Active, Inactive …) */
            .vchip, .rchip, .schip, .pchip, .stat-pill, .summary-chip {
                color: #e6edf3 !important;
            }
        }
    </style>
</head>
<body>


    <!-- ── TOPBAR ── -->
    <header class="topbar">
        <div class="topbar-brand">
            <div class="brand-icon">🧱</div>
            <div class="brand-name">
                <span data-i18n="brand.name">ज्योतिर्लिंग विट सप्लायर्स</span>
                <small data-i18n="brand.sub">कै. तानाजीराव माने वीट उद्योग समूह</small>
            </div>
        </div>

        <button class="sidebar-toggle" onclick="toggleSidebar()">☰</button>

        <div class="topbar-right">
            @* <div class="stat-chip">
                <span class="val" id="statLabour">—</span>
                <span class="lbl" data-i18n="topbar.activeLabour">Active Labour</span>
            </div>
            <div class="stat-chip">
                <span class="val" id="statProduction">—</span>
                <span class="lbl" data-i18n="topbar.todayBricks">Today's Bricks</span>
            </div>
            <div class="stat-chip">
                <span class="val" id="statPending">—</span>
                <span class="lbl" data-i18n="topbar.pendingAmt">Pending Amt</span>
            </div> *@

            <div class="lang-selector">
                <label data-i18n="lang.label">🌐 Language</label>
                <select id="langDropdown" onchange="changeLanguage(this.value)">
                    <option value="en">English</option>
                    <option value="mr">मराठी</option>
                </select>
            </div>

            <div class="topbar-avatar" title="@(Context.Session.GetString("Username") ?? "Admin")">
                @((Context.Session.GetString("Username") ?? "A").Substring(0, 1).ToUpper())
            </div>

            <a href="/Login/Logout" class="btn-logout" data-i18n="topbar.logout" onclick="event.preventDefault(); openLogoutModal();">↩ Logout</a>
        </div>
    </header>

    <!-- ── LOGOUT CONFIRMATION MODAL ── -->
    <div class="logout-overlay" id="logoutOverlay" onclick="if(event.target===this) closeLogoutModal()">
        <div class="logout-box">
            <div class="logout-icon">🚪</div>
            <h3 data-i18n="logout.title">Log out?</h3>
            <p data-i18n="logout.message">Are you sure you want to log out of your account?</p>
            <div class="logout-footer">
                <button type="button" class="lg-btn lg-btn-cancel" onclick="closeLogoutModal()" data-i18n="logout.no">No</button>
                <a href="/Login/Logout" class="lg-btn lg-btn-confirm" data-i18n="logout.yes">Yes, Logout</a>
            </div>
        </div>
    </div>

    <!-- ── SIDEBAR ── -->
    <nav class="sidebar" id="sidebar">
        <div class="sidebar-inner">

            <!-- OVERVIEW -->
            <div class="nav-group">
                <div class="nav-group-label" data-i18n="nav.overview">Overview</div>
                <a class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")"
                   href="/Login/Dashboard">
                    <span class="nav-icon">📊</span>
                    <span class="nav-label" data-i18n="nav.dashboard">Dashboard</span>
                </a>
            </div>

            <!-- MASTERS -->
            <div class="nav-group">
                <div class="nav-group-label" data-i18n="nav.grpMasters">Masters</div>
                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Vendor" ? "active" : "")"
                   href="/Vendor/Index">
                    <span class="nav-icon">🏪</span>
                    <span class="nav-label" data-i18n="nav.vendorMaster">Vendor Master</span>
                </a>
                <a class="nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Labour" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
