@model Brick_Manufacturing_Management_System.Models.AdvanceDeductionVM
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Advance Deduction";

    bool isEdit = Model.DeductionId > 0;
    int totalRec = Model.DeductionList.Count;
    decimal totalAmt = Model.DeductionList.Sum(d => d.Amount);

    int pageSize = 5;
    int pageCount = (int)Math.Ceiling((double)totalRec / pageSize);
}

@section Styles {
    <style>

        /* ══ PAGE HEADER ══ */
        .pg-hdr {
            margin-bottom: 22px;
        }

            .pg-hdr h2 {
                font-family: 'Rajdhani', sans-serif;
                font-size: 28px;
                font-weight: 700;
                letter-spacing: 2px;
                color: var(--text-pri);
                margin: 0;
            }

            .pg-hdr p {
                font-size: 12px;
                color: var(--text-sec);
                margin-top: 4px;
                display: flex;
                align-items: center;
                gap: 6px;
            }

        /* ══ SPLIT LAYOUT (mirrors MaterialPurchase) ══ */
        .split {
            display: grid;
            grid-template-columns: 340px 1fr;
            gap: 20px;
            align-items: start;
        }

        @@media (max-width: 960px) {
            .split {
                grid-template-columns: 1fr;
            }
        }

        /* ══ LEFT: FORM CARD ══ */
        .form-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 14px;
            overflow: hidden;
            position: sticky;
            top: 78px;
            max-height: calc(100vh - 100px);
            overflow-y: auto;
        }

            .form-card::-webkit-scrollbar {
                width: 4px;
            }

            .form-card::-webkit-scrollbar-track {
                background: transparent;
            }

            .form-card::-webkit-scrollbar-thumb {
                background: var(--border);
                border-radius: 4px;
            }

        .fc-hdr {
            padding: 16px 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            gap: 11px;
            position: sticky;
            top: 0;
            background: var(--bg-card);
            z-index: 2;
        }

        .fc-hdr-icon {
            width: 36px;
            height: 36px;
            border-radius: 9px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
        }

            .fc-hdr-icon.add-ic {
                background: rgba(224,123,57,.15);
            }

            .fc-hdr-icon.edit-ic {
                background: rgba(96,165,250,.15);
            }

        .fc-hdr h3 {
            font-family: 'Rajdhani', sans-serif;
            font-size: 18px;
            font-weight: 700;
            letter-spacing: 1px;
            margin: 0;
            line-height: 1.1;
        }

            .fc-hdr h3.add-ttl {
                color: var(--accent);
            }

            .fc-hdr h3.edit-ttl {
                color: #60a5fa;
            }

        .fc-hdr p {
            font-size: 11px;
            color: var(--text-sec);
            margin: 0;
        }

        /* Alert banners */
        .alert {
            padding: 10px 16px;
            border-radius: 8px;
            font-size: 12px;
            display: flex;
            align-items: center;
            gap: 8px;
            margin: 12px 20px 0;
        }

        .alert-success {
            background: rgba(34,211,164,.1);
            border: 1px solid rgba(34,211,164,.25);
            color: #22d3a4;
        }

        .alert-danger {
            background: rgba(248,81,73,.1);
            border: 1px solid rgba(248,81,73,.25);
            color: #f85149;
        }

        .fc-body {
            padding: 18px 20px 22px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        /* Form section label */
        .form-sec-lbl {
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            color: var(--accent);
            padding-bottom: 6px;
            border-bottom: 1px solid rgba(224,123,57,.2);
            margin-top: 4px;
        }

        /* Fields */
        .fg {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

            .fg label {
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 1.5px;
                text-transform: none;
                color: var(--text-sec);
            }

            .fg input, .fg select, .fg textarea {
                background: rgba(255,255,255,.04);
                border: 1px solid var(--border);
                border-radius: 8px;
                padding: 9px 12px;
                font-size: 13px;
                color: var(--text-pri);
                font-family: 'Nunito', sans-serif;
                outline: none;
                transition: border-color .2s, background .2s;
                width: 100%;
                box-sizing: border-box;
                -webkit-appearance: none;
                appearance: none;
            }

                .fg input:focus, .fg select:focus, .fg textarea:focus {
                    border-color: var(--accent);
                    background: rgba(224,123,57,.04);
                }

                .fg input[readonly] {
                    background: rgba(224,123,57,.07);
                    border-color: rgba(224,123,57,.25);
                    color: var(--accent);
                    font-weight: 700;
                    cursor: not-allowed;
                }

            .fg textarea {
                resize: vertical;
                min-height: 68px;
            }

            .fg select option {
                background: #0d1117;
                color: var(--text-pri);
            }

        .select-wrap {
            position: relative;
        }

            .select-wrap::after {
                content: '▾';
                position: absolute;
                right: 12px;
                top: 50%;
                transform: translateY(-50%);
                font-size: 12px;
                color: var(--text-sec);
                pointer-events: none;
            }

        /* Advance info box */
        .advance-info {
            background: rgba(255,255,255,.03);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 10px 14px;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .adv-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 11px;
            color: var(--text-sec);
        }

            .adv-row strong {
                font-family: 'Rajdhani', sans-serif;
                font-size: 13px;
            }

            .adv-row.balance strong {
                color: #22d3a4;
            }

            .adv-row.deduct strong {
                color: #f85149;
            }

        .adv-divider {
            border: none;
            border-top: 1px solid var(--border);
            margin: 2px 0;
        }

        /* Calc hint */
        .calc-hint {
            font-size: 10px;
            color: var(--text-sec);
            display: flex;
            align-items: center;
            gap: 4px;
        }

            .calc-hint span {
                color: var(--accent);
                font-weight: 700;
            }

        .verr {
            font-size: 10px;
            color: #f85149;
            display: none;
        }

            .verr.show {
                display: block;
            }

        .err-field {
            border-color: #f85149 !important;
        }

        /* Buttons */
        .btn-save {
            width: 100%;
            padding: 12px;
            border-radius: 9px;
            border: none;
            cursor: pointer;
            font-size: 13px;
            font-weight: 700;
            font-family: 'Nunito', sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            transition: background .2s, transform .15s;
        }

            .btn-save:active {
                transform: scale(.98);
            }

        .btn-save-add {
            background: var(--accent);
            color: #fff;
        }

            .btn-save-add:hover {
                background: #c96a28;
            }

        .btn-save-edit {
            background: rgba(96,165,250,.18);
            color: #60a5fa;
            border: 1px solid rgba(96,165,250,.35) !important;
        }

            .btn-save-edit:hover {
                background: rgba(96,165,250,.3);
            }

        .btn-cancel {
            width: 100%;
            padding: 10px;
            border-radius: 9px;
            cursor: pointer;
            background: transparent;
            color: var(--text-sec);
            font-size: 12px;
            font-weight: 600;
            font-family: 'Nunito', sans-serif;
            border: 1px solid var(--border);
            transition: all .2s;
            text-align: center;
            text-decoration: none;
            display: block;
            box-sizing: border-box;
        }

            .btn-cancel:hover {
                border-color: var(--accent);
                color: var(--accent);
            }

        /* ══ RIGHT: TABLE CARD ══ */
        .table-card {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 14px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .tc-hdr {
            padding: 14px 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 10px;
        }

        .tc-hdr-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .tc-hdr-icon {
            width: 36px;
            height: 36px;
            background: rgba(224,123,57,.12);
            border-radius: 9px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 17px;
            flex-shrink: 0;
        }

        .tc-hdr h3 {
            font-family: 'Rajdhani', sans-serif;
            font-size: 19px;
            font-weight: 700;
            letter-spacing: 1px;
            color: var(--text-pri);
            margin: 0;
            line-height: 1.1;
        }

        .tc-hdr p {
            font-size: 11px;
            color: var(--text-sec);
            margin: 0;
        }

        .tc-badge {
            background: var(--accent);
            color: #fff;
            font-family: 'Rajdhani', sans-serif;
            font-size: 13px;
            font-weight: 700;
            padding: 5px 16px;
            border-radius: 20px;
            white-space: nowrap;
        }

        /* Summary chips */
        .tc-chips {
            padding: 10px 20px;
            border-bottom: 1px solid var(--border);
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .rchip {
            display: flex;
            align-items: center;
            gap: 6px;
            background: rgba(255,255,255,.03);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 6px 14px;
            font-size: 11px;
            color: var(--text-sec);
        }

            .rchip strong {
                font-family: 'Rajdhani', sans-serif;
                font-size: 14px;
            }

        /* Search */
        .tc-search {
            padding: 10px 20px;
            border-bottom: 1px solid var(--border);
        }

        .sw {
            position: relative;
        }

            .sw i {
                position: absolute;
                left: 12px;
                top: 50%;
                transform: translateY(-50%);
                font-size: 13px;
                color: var(--text-sec);
                pointer-events: none;
            }

            .sw input {
                width: 100%;
                padding: 9px 13px 9px 35px;
                background: rgba(255,255,255,.04);
                border: 1px solid var(--border);
                border-radius: 8px;
                color: var(--text-pri);
                font-family: 'Nunito', sans-serif;
                font-size: 12px;
                outline: none;
                transition: border-color .2s;
                box-sizing: border-box;
            }

                .sw input::placeholder {
                    color: var(--text-sec);
                    opacity: .5;
                }

                .sw input:focus {
                    border-color: var(--accent);
                }

        /* Table */
        .tbl-wrap {
            overflow-x: auto;
            overflow-y: visible;
            scrollbar-width: thin;
            scrollbar-color: var(--border) transparent;
        }

            .tbl-wrap::-webkit-scrollbar {
                height: 6px;
            }

            .tbl-wrap::-webkit-scrollbar-track {
                background: transparent;
            }

            .tbl-wrap::-webkit-scrollbar-thumb {
                background: var(--border);
                border-radius: 3px;
            }

                .tbl-wrap::-webkit-scrollbar-thumb:hover {
                    background: var(--accent);
                }

        .ptbl {
            width: 100%;
            border-collapse: collapse;
            font-size: 12.5px;
            min-width: 780px;
        }

            .ptbl thead th {
                padding: 10px 13px;
                text-align: left;
                font-size: 9px;
                letter-spacing: 1.5px;
                text-transform: uppercase;
                color: var(--text-sec);
                font-weight: 700;
                border-bottom: 1px solid var(--border);
                background: var(--bg-card);
                white-space: nowrap;
            }

            .ptbl tbody td {
                padding: 10px 13px;
                border-bottom: 1px solid var(--border);
                color: var(--text-pri);
                vertical-align: middle;
            }

            .ptbl tbody tr:last-child td {
                border-bottom: none;
            }

            .ptbl tbody tr:hover td {
                background: rgba(224,123,57,.04);
            }

            .ptbl tbody tr.editing-row td {
                background: rgba(96,165,250,.06);
            }

            .ptbl tbody tr.hidden-row {
                display: none;
            }

        /* Labour avatar */
        .name-cell {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .av {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: linear-gradient(135deg, #e07b39, #7c3510);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            font-weight: 700;
            color: #fff;
            flex-shrink: 0;
        }

        /* Amount */
        .amt-badge {
            color: #f85149;
            font-weight: 700;
            font-family: 'Rajdhani', sans-serif;
            font-size: 13px;
        }

        /* Reason text */
        .reason-txt {
            max-width: 220px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            color: var(--text-sec);
            font-size: 11px;
        }

        /* Action buttons */
        .act {
            display: flex;
            gap: 5px;
        }

        .abtn {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 10px;
            font-weight: 700;
            border: none;
            cursor: pointer;
            font-family: 'Nunito', sans-serif;
            transition: background .2s;
            text-decoration: none;
        }

        .abtn-edit {
            background: rgba(96,165,250,.12);
            color: #60a5fa;
            border: 1px solid rgba(96,165,250,.2) !important;
        }

            .abtn-edit:hover {
                background: rgba(96,165,250,.25);
            }

        .abtn-del {
            background: rgba(248,81,73,.10);
            color: #f85149;
            border: 1px solid rgba(248,81,73,.2) !important;
        }

            .abtn-del:hover {
                background: rgba(248,81,73,.25);
            }

        /* Empty / no-search */
        .empty-state {
            text-align: center;
            padding: 60px 20px;
            color: var(--text-sec);
            font-size: 13px;
        }

            .empty-state .es-icon {
                font-size: 36px;
                margin-bottom: 10px;
                display: block;
            }

        #noSearch {
            display: none;
            text-align: center;
            padding: 28px;
            color: var(--text-sec);
            font-size: 12px;
        }

        /* ══ PAGINATION ══ */
        .table-card {
            display: flex;
            flex-direction: column;
        }

        .tc-pagination {
            padding: 12px 20px;
            border-top: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 8px;
            background: rgba(224,123,57,.02);
        }

        .pg-info {
            font-size: 11px;
            color: var(--text-sec);
        }

            .pg-info span {
                color: var(--text-pri);
                font-weight: 700;
            }

        .pg-btns {
            display: flex;
            align-items: center;
            gap: 4px;
            flex-wrap: wrap;
        }

        .pg-btn {
            min-width: 32px;
            height: 32px;
            border-radius: 7px;
            border: 1px solid var(--border);
            background: transparent;
            color: var(--text-sec);
            font-size: 12px;
            font-weight: 600;
            font-family: 'Nunito', sans-serif;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all .18s;
            padding: 0 8px;
        }

            .pg-btn:hover:not(:disabled):not(.pg-dots) {
                border-color: var(--accent);
                color: var(--accent);
                background: rgba(224,123,57,.07);
            }

            .pg-btn.active {
                background: var(--accent);
                color: #fff;
                border-color: var(--accent);
                font-weight: 700;
                box-shadow: 0 2px 8px rgba(224,123,57,.4);
            }

            .pg-btn:disabled {
                opacity: .3;
                cursor: not-allowed;
            }

            .pg-btn.pg-dots {
                border-color: transparent;
                cursor: default;
                color: var(--text-sec);
                letter-spacing: 1px;
            }

        .pg-size-wrap {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 11px;
            color: var(--text-sec);
        }

            .pg-size-wrap select {
                background: rgba(255,255,255,.04);
                border: 1px solid var(--border);
                border-radius: 6px;
                color: var(--text-pri);
                font-size: 11px;
                font-family: 'Nunito', sans-serif;
                padding: 4px 8px;
                outline: none;
                cursor: pointer;
                -webkit-appearance: none;
                appearance: none;
            }

                .pg-size-wrap select:focus {
                    border-color: var(--accent);
                }

        /* ══ DELETE MODAL ══ */
        .del-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.65);
            z-index: 500;
            align-items: center;
            justify-content: center;
        }

            .del-overlay.show {
                display: flex;
            }

        .del-box {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 26px;
            width: 360px;
            max-width: 90vw;
            animation: popIn .22s ease;
        }

        @@keyframes popIn {
            from {
                transform: scale(.9);
                opacity: 0;
            }

            to {
                transform: scale(1);
                opacity: 1;
            }
        }

        .del-box h3 {
            font-family: 'Rajdhani', sans-serif;
            font-size: 20px;
            color: #f85149;
            margin-bottom: 8px;
        }

        .del-box p {
            font-size: 12px;
            color: var(--text-sec);
            line-height: 1.6;
        }

        .del-footer {
            display: flex;
            gap: 8px;
            justify-content: flex-end;
            margin-top: 18px;
        }

        .btn-dc {
            padding: 8px 16px;
            border-radius: 7px;
            font-size: 12px;
            font-weight: 700;
            font-family: 'Nunito', sans-serif;
            cursor: pointer;
            border: none;
        }

        .btn-dc-cancel {
            background: rgba(255,255,255,.06);
            color: var(--text-sec);
            border: 1px solid var(--border) !important;
        }

        .btn-dc-del {
            background: rgba(248,81,73,.14);
            color: #f85149;
            border: 1px solid rgba(248,81,73,.3) !important;
            transition: background .2s;
        }

            .btn-dc-del:hover {
                background: rgba(248,81,73,.28);
            }

    </style>
}

<!-- PAGE HEADER -->
<div class="pg-hdr">
    <h2 data-i18n="deduction.title">ADVANCE DEDUCTION</h2>
    <p>
        <i class="fas fa-circle" style="font-size:8px;color:#22d3a4;"></i>
        <span data-i18n="deduction.subtitle">Deduct from labour advance balance</span>
    </p>
</div>

<div class="split">

    <!-- ════ LEFT: FORM CARD ════ -->
    <div class="form-card">
        <div class="fc-hdr">
            <div class="fc-hdr-icon @(isEdit ? "edit-ic" : "add-ic")">
                @(isEdit ? "✏️" : "💸")
            </div>
            <div>
                <h3 class="@(isEdit ? "edit-ttl" : "add-ttl")" data-i18n='@(isEdit ? "deduction.editDeduction" : "deduction.newDeduction")'>
                    @(isEdit ? "EDIT DEDUCTION" : "NEW DEDUCTION")
                </h3>
                <p data-i18n='@(isEdit ? "deduction.editSub" : "deduction.newSub")'>@(isEdit ? "Update deduction record" : "Record an advance deduction")</p>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success" id="dedAlert">✅ @TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger" id="dedAlert">⚠️ @TempData["Error"]</div>
        }

        <form asp-action="Save" asp-controller="AdvanceDeduction" method="post" novalidate id="dedForm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="DeductionId" />

            <div class="fc-body">

                <div class="form-sec-lbl" data-i18n="purchase.pricing">📋 Deduction Details</div>

                <!-- Deduction Date -->
                <div class="fg">
                    <label data-i18n="deduction.deductionDate">Deduction Date *</label>
                    <input asp-for="DeductionDate" type="date"
                           value="@Model.DeductionDate?.ToString("yyyy-MM-dd")"
                           class="@(ViewData.ModelState["DeductionDate"]?.Errors.Count > 0 ? "err-field" : "")" />
                    <span asp-validation-for="DeductionDate" class="verr show"></span>
                </div>

                <!-- Labour -->
                <div class="fg">
                    <label data-i18n="form.labour">Labour *</label>
                    <div class="select-wrap">
                        <select asp-for="LabourId" asp-items="Model.LabourOptions"
                                id="selLabour"
                                onchange="fetchAdvanceInfo(this.value)"
                                class="@(ViewData.ModelState["LabourId"]?.Errors.Count > 0 ? "err-field" : "")">
                            <option value="">— Select Labour —</option>
                        </select>
                    </div>
                    <span asp-validation-for="LabourId" class="verr show"></span>
                </div>

                <!-- Advance Info Box (populated by AJAX) -->
                <div class="advance-info" id="advanceInfoBox">
                    <div class="adv-row">
                        <span>Total Advance Taken</span>
                        <strong id="dispTotalAdv">₹ @Model.CurrentAdvance.ToString("N2")</strong>
                    </div>
                    <hr class="adv-divider" />
                    <div class="adv-row balance">
                        <span>Available Balance</span>
                        <strong id="dispBalance">₹ @Model.AdvanceBalance.ToString("N2")</strong>
                    </div>
                </div>

                <div class="form-sec-lbl" data-i18n="purchase.payment">💰 Deduction Info</div>

                <!-- Amount -->
                <div class="fg">
                    <label data-i18n="deduction.deductionAmt">Deduction Amount (₹) *</label>
                    <input asp-for="Amount" type="number" step="0.01" min="0.01"
                           placeholder="0.00" id="fAmount" oninput="calcBalance()" onwheel="this.blur()"
                           class="@(ViewData.ModelState["Amount"]?.Errors.Count > 0 ? "err-field" : "")" />
                    <span asp-validation-for="Amount" class="verr show"></span>
                    <div class="calc-hint">🧮 Balance after deduction = <span id="balAfterHint">@Model.AdvanceBalance.ToString("N2")</span></div>
                </div>

                <!-- Reason -->
                <div class="fg">
                    <label data-i18n="form.reason">Reason *</label>
                    <textarea asp-for="Reason" placeholder="e.g. Overtime, Personal need…"
                              class="@(ViewData.ModelState["Reason"]?.Errors.Count > 0 ? "err-field" : "")"></textarea>
                    <span asp-validation-for="Reason" class="verr show"></span>
                </div>

                <!-- Buttons -->
                <div style="margin-top:6px; display:flex; flex-direction:column; gap:8px;">
                    <button type="submit" class="btn-save @(isEdit ? "btn-save-edit" : "btn-save-add")" data-i18n='@(isEdit ? "deduction.updateBtn" : "deduction.saveBtn")'>
                        @(isEdit ? "💾 Update Deduction" : "＋ Save Deduction")
                    </button>
                    @if (isEdit)
                    {
                        <a href="/AdvanceDeduction/Index" class="btn-cancel" data-i18n="common.cancelEdit">↺ Cancel Edit</a>
                    }
                    else
                    {
                        <button type="button" class="btn-cancel" onclick="resetForm()" data-i18n="common.reset">↺ Reset</button>
                    }
                </div>

            </div>
        </form>
    </div>

    <!-- ════ RIGHT: TABLE CARD ════ -->
    <div class="table-card">

        <div class="tc-hdr">
            <div class="tc-hdr-left">
                <div class="tc-hdr-icon">💸</div>
                <div>
                    <h3 data-i18n="deduction.deductionList">Deduction List</h3>
                    <p data-i18n="deduction.listSub">All recorded advance deductions</p>
                </div>
            </div>
            <span class="tc-badge">@totalRec Record@(totalRec != 1 ? "s" : "")</span>
        </div>

        <div class="tc-chips">
            <div class="rchip"><span data-i18n="deduction.totalDeducted">Total Deducted</span> &nbsp;<strong style="color:#f85149;">₹@totalAmt.ToString("N2")</strong></div>
            <div class="rchip"><span data-i18n="deduction.records">Records</span> &nbsp;<strong style="color:var(--text-pri);">@totalRec</strong></div>
        </div>

        <div class="tc-search">
            <div class="sw">
                <i class="fas fa-magnifying-glass"></i>
                <input type="text" id="searchInput" data-i18n-placeholder="deduction.search" placeholder="Search by labour, reason…" oninput="filterTable()" />
            </div>
        </div>

        @if (!Model.DeductionList.Any())
        {
            <div class="empty-state">
                <span class="es-icon">💸</span>
                No deduction records yet.<br />Add your first deduction using the form.
            </div>
        }
        else
        {
            <div class="tbl-wrap">
                <table class="ptbl" id="dedTable">
                    <thead>
                        <tr>
                            <th style="width:46px;">#</th>
                            <th data-i18n="form.date">Date</th>
                            <th data-i18n="form.labour">Labour</th>
                            <th data-i18n="form.amount">Amount</th>
                            <th data-i18n="form.reason">Reason</th>
                            <th style="width:120px;text-align:center;" data-i18n="common.actions">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="dedBody">
                        @foreach (var d in Model.DeductionList)
                        {
                            bool isEditing = Model.DeductionId == d.DeductionId;

                            var initials = string.Join("", d.LabourName.Split(' ')
                            .Take(2)
                            .Select(w => w.Length > 0 ? w[0].ToString() : ""))
                            .ToUpper();

                            string safeName = d.LabourName.Replace("'", "\\'");
                            string safeReason = d.Reason.Replace("'", "\\'");

                            <tr class="@(isEditing ? "editing-row" : "")"
                                id="row-@d.DeductionId"
                                data-search="@d.LabourName.ToLower() @d.Reason.ToLower()">
                                <td style="color:var(--text-sec);font-size:11px;">@d.DeductionId</td>
                                <td style="white-space:nowrap;font-size:11px;font-weight:600;">
                                    @d.DeductionDate.ToString("dd MMM yy")
                                </td>
                                <td>
                                    <div class="name-cell">
                                        <div class="av">@initials</div>
                                        <span style="font-weight:600;">@d.LabourName</span>
                                    </div>
                                </td>
                                <td><span class="amt-badge">₹@d.Amount.ToString("N2")</span></td>
                                <td>
                                    <div class="reason-txt" title="@d.Reason">@d.Reason</div>
                                </td>
                                <td>
                                    <div class="act" style="justify-content:center;">
                                        <a href="/AdvanceDeduction/Index?editId=@d.DeductionId" class="abtn abtn-edit">
                                            <i class="fas fa-pen"></i> Edit
                                        </a>
                                        <button type="button" class="abtn abtn-del"
                                                onclick="openDel(@d.DeductionId, '@safeName', '@safeReason')">
                                            <i class="fas fa-trash"></i> Del
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div id="noSearch">
                <i class="fas fa-magnifying-glass" style="font-size:22px;margin-bottom:8px;display:block;opacity:.4;"></i>
                No records match your search.
            </div>

            <!-- ════ PAGINATION ════ -->
            <div class="tc-pagination">
                <div class="pg-info">
                    Showing <span id="pgFrom">1</span>–<span id="pgTo">@Math.Min(pageSize, totalRec)</span>
                    of <span id="pgTotal">@totalRec</span> records
                </div>
                <div class="pg-btns" id="pgBtns"></div>
                <div class="pg-size-wrap">
                    Rows:
                    <select id="pgSizeSelect" onchange="changePageSize(+this.value)">
                        <option value="5" selected>5</option>
                        <option value="8">8</option>
                        <option value="15">15</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                    </select>
                </div>
            </div>
        }

    </div><!-- /table-card -->

</div><!-- /split -->
<!-- DELETE MODAL -->
<div class="del-overlay" id="delOverlay">
    <div class="del-box">
        <h3 data-i18n="deduction.deleteTitle">⚠️ Delete Deduction?</h3>
        <p>
            You are about to permanently delete the deduction for
            <strong id="delName" style="color:var(--accent);"></strong>
            — <em id="delReason" style="color:var(--text-sec);"></em>.<br />
            This action cannot be undone.
        </p>
        <div class="del-footer">
            <button type="button" class="btn-dc btn-dc-cancel" onclick="closeDel()" data-i18n="common.cancel">Cancel</button>
            <form id="delForm" method="post" style="margin:0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-dc btn-dc-del" data-i18n="common.yesDelete">Yes, Delete</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const TOTAL_ROWS = @totalRec;
        let pageSize    = 5;
        let currentPage = 0;
        let isSearching = false;

        // Current advance balance for live hint
        let currentBalance = @Model.AdvanceBalance.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);

        function getPageCount() { return Math.max(1, Math.ceil(TOTAL_ROWS / pageSize)); }

        function assignPages() {
            document.querySelectorAll('#dedBody tr').forEach((r, i) => {
                r.dataset.page = Math.floor(i / pageSize);
            });
        }

        function renderPagination() {
            const pc  = getPageCount();
            const box = document.getElementById('pgBtns');
            box.innerHTML = '';

            function btn(label, page, cls) {
                const b = document.createElement('button');
                b.className = 'pg-btn' + (cls ? ' ' + cls : '');
                b.innerHTML = label;
                if (page !== null) b.onclick = () => changePage(page);
                else b.disabled = true;
                return b;
            }

            const prev = btn('&#8249;', currentPage - 1);
            prev.disabled = currentPage === 0;
            box.appendChild(prev);

            const show = new Set([0, pc - 1]);
            for (let i = Math.max(0, currentPage - 2); i <= Math.min(pc - 1, currentPage + 2); i++) show.add(i);
            let prev_p = -1;
            [...show].sort((a, b) => a - b).forEach(p => {
                if (p - prev_p > 1) box.appendChild(btn('…', null, 'pg-dots'));
                box.appendChild(btn(p + 1, p, p === currentPage ? 'active' : ''));
                prev_p = p;
            });

            const next = btn('&#8250;', currentPage + 1);
            next.disabled = currentPage >= pc - 1;
            box.appendChild(next);
        }

        function showPage(p) {
            currentPage = p;
            document.querySelectorAll('#dedBody tr').forEach(r => {
                r.classList.toggle('hidden-row', parseInt(r.dataset.page) !== p);
            });
            document.getElementById('pgFrom').textContent  = p * pageSize + 1;
            document.getElementById('pgTo').textContent    = Math.min((p + 1) * pageSize, TOTAL_ROWS);
            document.getElementById('pgTotal').textContent = TOTAL_ROWS;
            renderPagination();
        }

        function changePage(p) {
            if (p < 0 || p >= getPageCount()) return;
            showPage(p);
        }

        function changePageSize(val) {
            pageSize = val;
            currentPage = 0;
            assignPages();
            showPage(0);
        }

        assignPages();
        if (TOTAL_ROWS > 0) showPage(0);

        /* ── AJAX: fetch advance info when labour selected ── */
        async function fetchAdvanceInfo(labourId) {
            if (!labourId) {
                document.getElementById('dispTotalAdv').textContent = '₹ 0.00';
                document.getElementById('dispBalance').textContent  = '₹ 0.00';
                document.getElementById('balAfterHint').textContent = '0.00';
                currentBalance = 0;
                calcBalance();
                return;
            }
            try {
                const res  = await fetch('/AdvanceDeduction/GetAdvanceInfo?labourId=' + labourId);
                const data = await res.json();
                if (data.success) {
                    currentBalance = data.balance;
                    document.getElementById('dispTotalAdv').textContent =
                        '₹ ' + data.totalAdvance.toLocaleString('en-IN', { minimumFractionDigits: 2 });
                    document.getElementById('dispBalance').textContent  =
                        '₹ ' + data.balance.toLocaleString('en-IN', { minimumFractionDigits: 2 });
                    calcBalance();
                }
            } catch (e) {
                console.warn('Failed to fetch advance info:', e);
            }
        }

        /* ── Live balance hint ── */
        function calcBalance() {
            const amt     = parseFloat(document.getElementById('fAmount').value) || 0;
            const after   = Math.max(0, currentBalance - amt);
            const hintEl  = document.getElementById('balAfterHint');
            if (hintEl) hintEl.textContent = after.toLocaleString('en-IN', { minimumFractionDigits: 2 });

            // Red border if deduction exceeds balance
            const amtEl = document.getElementById('fAmount');
            if (amtEl) amtEl.style.borderColor = (amt > currentBalance && currentBalance >= 0) ? '#f85149' : '';
        }

        /* ── Reset form ── */
        /* ── Auto-dismiss success/error alert after 3.5 seconds ── */
        (function () {
            var alertBox = document.getElementById('dedAlert');
            if (alertBox) {
                setTimeout(function () {
                    alertBox.style.transition = 'opacity .5s ease';
                    alertBox.style.opacity = '0';
                    setTimeout(function () { alertBox.remove(); }, 500);
                }, 3500);
            }
        })();

        /* ── Clear validation error as soon as user interacts with a field ── */
        (function () {
            var f = document.getElementById('dedForm');
            if (!f) return;
            f.querySelectorAll('input, select, textarea').forEach(function (el) {
                var evt = (el.tagName === 'SELECT' || el.type === 'date') ? 'change' : 'input';
                el.addEventListener(evt, function () {
                    this.classList.remove('err-field');
                    var fg = this.closest('.fg') || (this.closest('.select-wrap') && this.closest('.select-wrap').closest('.fg'));
                    if (fg) {
                        var errSpan = fg.querySelector('.verr');
                        if (errSpan) errSpan.classList.remove('show');
                    }
                });
            });
        })();

        function resetForm() {
            document.getElementById('dedForm').reset();
            document.querySelectorAll('.verr').forEach(e => e.classList.remove('show'));
            document.querySelectorAll('.err-field').forEach(e => e.classList.remove('err-field'));
            document.getElementById('dispTotalAdv').textContent = '₹ 0.00';
            document.getElementById('dispBalance').textContent  = '₹ 0.00';
            document.getElementById('balAfterHint').textContent = '0.00';
            const amtEl = document.getElementById('fAmount');
            if (amtEl) amtEl.style.borderColor = '';
            currentBalance = 0;
            const today  = new Date().toISOString().split('T')[0];
            const dateEl = document.querySelector('input[name="DeductionDate"]');
            if (dateEl) dateEl.value = today;
        }

        /* ── Search ── */
        function filterTable() {
            const q    = document.getElementById('searchInput').value.toLowerCase().trim();
            const rows = Array.from(document.querySelectorAll('#dedBody tr'));
            isSearching = q.length > 0;

            if (!isSearching) {
                assignPages();
                showPage(0);
                document.getElementById('noSearch').style.display = 'none';
                return;
            }

            let vis = 0;
            rows.forEach(r => {
                const match = ((r.dataset.search || '') + ' ' + r.textContent.toLowerCase()).includes(q);
                r.classList.toggle('hidden-row', !match);
                if (match) vis++;
            });
            document.getElementById('noSearch').style.display = vis === 0 ? 'block' : 'none';
            document.getElementById('pgFrom').textContent  = vis > 0 ? 1 : 0;
            document.getElementById('pgTo').textContent    = vis;
            document.getElementById('pgTotal').textContent = vis;
            document.getElementById('pgBtns').innerHTML    = '';
        }

        /* ── Delete modal ── */
        function openDel(id, name, reason) {
            document.getElementById('delName').textContent   = name;
            document.getElementById('delReason').textContent = reason;
            document.getElementById('delForm').action = '/AdvanceDeduction/Delete/' + id;
            document.getElementById('delOverlay').classList.add('show');
        }
        function closeDel() {
            document.getElementById('delOverlay').classList.remove('show');
        }
        document.getElementById('delOverlay').addEventListener('click', function(e) {
            if (e.target === this) closeDel();
        });

        /* ── Jump to editing row's page ── */
        const editRow = document.querySelector('.editing-row');
        if (editRow) {
            changePage(parseInt(editRow.dataset.page) || 0);
            setTimeout(() => editRow.scrollIntoView({ behavior: 'smooth', block: 'center' }), 100);
        }

        /* ── Init balance hint if editing ── */
        (function initEdit() {
            const labourSel = document.getElementById('selLabour');
            if (labourSel && labourSel.value) {
                // Already have balance from server — just sync the hint
                calcBalance();
            }
        })();
    </script>
}
