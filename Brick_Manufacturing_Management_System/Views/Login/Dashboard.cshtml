@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Dashboard";
    var username = Context.Session.GetString("Username") ?? "Admin";
    var today = DateOnly.FromDateTime(DateTime.Today);
}

@section Styles {
    <style>
        .welcome-banner {
            background: linear-gradient(135deg, rgba(224,123,57,.18) 0%, rgba(224,123,57,.06) 100%);
            border: 1px solid rgba(224,123,57,.22);
            border-radius: 14px;
            padding: 22px 28px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 14px;
            position: relative;
            overflow: hidden;
        }
        .welcome-banner::before {
            content: '🧱';
            position: absolute;
            right: 24px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 80px;
            opacity: .06;
            pointer-events: none;
        }
        .wb-left h2 { font-family:'Rajdhani',sans-serif; font-size:26px; font-weight:700; color:var(--text-pri); letter-spacing:1px; }
        .wb-left h2 span { color:var(--accent); }
        .wb-left p { font-size:13px; color:var(--text-sec); margin-top:3px; }
        .wb-chips { display:flex; gap:10px; flex-wrap:wrap; }
        .wb-chip { display:flex; align-items:center; gap:6px; background:rgba(224,123,57,.09); border:1px solid rgba(224,123,57,.18); border-radius:20px; padding:5px 13px; font-size:12px; color:var(--text-sec); }
        .wb-chip strong { color:var(--text-pri); }

        /* ══ STAT GRID ══ */
        .stat-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
            gap: 14px;
            margin-bottom: 26px;
        }

        .sc {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 18px 16px 14px;
            position: relative;
            overflow: hidden;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 130px;
            animation: fadeUp .45s both;
            transition: transform .22s cubic-bezier(.34,1.56,.64,1),
                        box-shadow .22s ease,
                        border-color .22s ease;
        }

        /* glowing top stripe */
        .sc::after {
            content: '';
            position: absolute;
            top: 0; left: 0; right: 0;
            height: 3px;
            background: var(--sc-color, var(--accent));
            border-radius: 14px 14px 0 0;
            transition: height .22s ease;
        }

        /* subtle bottom glow blob */
        .sc::before {
            content: '';
            position: absolute;
            bottom: -30px; right: -20px;
            width: 90px; height: 90px;
            border-radius: 50%;
            background: radial-gradient(circle, var(--sc-color, var(--accent)) 0%, transparent 70%);
            opacity: .07;
            transition: opacity .22s, transform .22s;
            pointer-events: none;
        }

        /* dancing hover */
        .sc:hover {
            transform: translateY(-6px) scale(1.025);
            box-shadow: 0 16px 36px rgba(0,0,0,.45), 0 0 0 1px var(--sc-color, var(--accent));
            border-color: var(--sc-color, var(--accent));
        }

        .sc:hover::after { height: 5px; }
        .sc:hover::before { opacity: .14; transform: scale(1.2); }

        /* active press */
        .sc:active { transform: translateY(-2px) scale(1.01); }

        .sc-icon {
            width: 38px; height: 38px;
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 18px;
            background: rgba(224,123,57,.1);
            margin-bottom: 10px;
            transition: transform .22s cubic-bezier(.34,1.56,.64,1);
            flex-shrink: 0;
        }

        .sc:hover .sc-icon { transform: rotate(-8deg) scale(1.15); }

        .sc-val {
            font-family: 'Rajdhani', sans-serif;
            font-size: 28px;
            font-weight: 700;
            color: var(--text-pri);
            line-height: 1;
            word-break: break-all;
            /* shrink font for long rupee values */
        }

        /* auto-shrink for long values via JS class */
        .sc-val.val-sm  { font-size: 20px; }
        .sc-val.val-xs  { font-size: 16px; }

        .sc-lbl {
            font-size: 11.5px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #e6edf3;
            margin-top: 5px;
            line-height: 1.3;
        }

        .sc-link {
            display: inline-flex; align-items: center; gap: 4px;
            margin-top: 10px;
            font-size: 11px; font-weight: 700;
            color: var(--sc-color, var(--accent));
            text-decoration: none;
            opacity: .65;
            transition: opacity .18s, gap .18s;
        }

        .sc-link:hover { opacity: 1; gap: 7px; }

        /* colour themes */
        .c1{--sc-color:#e07b39} .c1 .sc-icon{background:rgba(224,123,57,.13)}
        .c2{--sc-color:#f5c542} .c2 .sc-icon{background:rgba(245,197,66,.12)}
        .c3{--sc-color:#22d3a4} .c3 .sc-icon{background:rgba(34,211,164,.12)}
        .c4{--sc-color:#60a5fa} .c4 .sc-icon{background:rgba(96,165,250,.12)}
        .c5{--sc-color:#a78bfa} .c5 .sc-icon{background:rgba(167,139,250,.12)}
        .c6{--sc-color:#f472b6} .c6 .sc-icon{background:rgba(244,114,182,.12)}
        .c7{--sc-color:#fb923c} .c7 .sc-icon{background:rgba(251,146,60,.12)}
        .c8{--sc-color:#34d399} .c8 .sc-icon{background:rgba(52,211,153,.12)}
        .c10{--sc-color:#f85149} .c10 .sc-icon{background:rgba(248,81,73,.12)}

        /* ══ SECTION HEADER ══ */
        .sec-hdr {
            display: flex; align-items: center; justify-content: space-between;
            margin: 26px 0 12px;
            flex-wrap: wrap; gap: 6px;
        }
        .sec-hdr h3 {
            font-family: 'Rajdhani', sans-serif; font-size: 17px; font-weight: 700;
            letter-spacing: 1.5px; color: var(--text-pri);
            display: flex; align-items: center; gap: 8px;
        }
        .sec-hdr h3 span { color: var(--accent); font-size: 16px; }
        .sec-hdr a { font-size: 12px; color: var(--accent); text-decoration: none; font-weight: 700; white-space: nowrap; transition: gap .18s; }
        .sec-hdr a:hover { text-decoration: underline; }

        /* ══ PANEL (card wrapper) ══ */
        .panel {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 14px;
            overflow: hidden;
            transition: box-shadow .22s ease, border-color .22s ease;
        }
        .panel:hover {
            box-shadow: 0 8px 28px rgba(0,0,0,.35);
            border-color: rgba(224,123,57,.22);
        }

        /* ══ TABLE ══ */
        .tbl-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: thin; scrollbar-color: var(--border) transparent; }
        .tbl-scroll::-webkit-scrollbar { height: 4px; }
        .tbl-scroll::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }

        .dtbl { width: 100%; border-collapse: collapse; font-size: 12.5px; min-width: 480px; }
        .dtbl thead tr { background: rgba(224,123,57,.06); }
        .dtbl th {
            padding: 10px 12px; text-align: left;
            font-size: 9.5px; letter-spacing: 1.5px; text-transform: uppercase;
            color: var(--text-sec); font-weight: 700;
            border-bottom: 1px solid var(--border);
            white-space: nowrap;
        }
        .dtbl td {
            padding: 10px 12px; border-bottom: 1px solid var(--border);
            color: var(--text-pri); vertical-align: middle;
            max-width: 160px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
        }
        .dtbl td.amt { white-space: nowrap; max-width: none; }
        .dtbl tbody tr:last-child td { border-bottom: none; }
        .dtbl tbody tr {
            transition: background .15s, transform .15s;
        }
        .dtbl tbody tr:hover td { background: rgba(224,123,57,.05); }

        /* ══ BADGES ══ */
        .bdg { display:inline-flex; align-items:center; gap:4px; padding:3px 10px; border-radius:20px; font-size:10.5px; font-weight:700; white-space:nowrap; }
        .bdg-paid    { background:rgba(34,211,164,.14); color:#22d3a4; }
        .bdg-pending { background:rgba(245,197,66,.14); color:#f5c542; }
        .bdg-unpaid  { background:rgba(248,81,73,.14);  color:#f85149; }
        .bdg-active  { background:rgba(34,211,164,.14); color:#22d3a4; }

        /* ══ AVATAR ══ */
        .av { width:30px; height:30px; border-radius:50%; background:linear-gradient(135deg,#e07b39,#7c3510); display:inline-flex; align-items:center; justify-content:center; font-size:10px; font-weight:700; color:#fff; flex-shrink:0; }
        .name-cell { display:flex; align-items:center; gap:9px; min-width:0; }
        .name-cell span { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }

        /* ══ QLIST (Labour / Advance / Salary panels) ══ */
        .qlist { display: flex; flex-direction: column; }
        .qlist-item {
            display: flex; align-items: center; justify-content: space-between;
            padding: 11px 16px; border-bottom: 1px solid var(--border);
            gap: 10px;
            transition: background .15s, transform .18s cubic-bezier(.34,1.56,.64,1);
        }
        .qlist-item:last-child { border-bottom: none; }
        .qlist-item:hover { background: rgba(224,123,57,.05); transform: translateX(3px); }
        .qlist-left { display:flex; align-items:center; gap:10px; font-size:13px; color:var(--text-pri); min-width:0; flex:1; }
        .qlist-icon { width:32px; height:32px; border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:14px; background:rgba(224,123,57,.1); flex-shrink:0; }
        .qlist-sub { font-size:11px; color:var(--text-sec); margin-top:2px; }

        /* alert items */
        .alert-item {
            display:flex; align-items:center; gap:12px; padding:12px 16px;
            border-bottom:1px solid var(--border);
            transition: background .15s, transform .18s cubic-bezier(.34,1.56,.64,1);
        }
        .alert-item:last-child { border-bottom:none; }
        .alert-item:hover { background:rgba(248,81,73,.04); transform:translateX(3px); }
        .alert-info .an { font-size:13px; font-weight:600; color:var(--text-pri); }
        .alert-info .am { font-size:11px; color:var(--text-sec); margin-top:2px; }

        /* ══ RESPONSIVE GRID LAYOUTS ══ */
        .two-col {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
        }

        .three-col {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 18px;
        }

        @@media (max-width: 1200px) {
            .three-col { grid-template-columns: 1fr 1fr; }
        }

        @@media (max-width: 860px) {
            .two-col   { grid-template-columns: 1fr; }
            .three-col { grid-template-columns: 1fr; }
        }

        @@media (max-width: 600px) {
            .welcome-banner { padding: 16px 18px; }
            .wb-left h2 { font-size: 20px; }
            .sec-hdr { margin: 18px 0 10px; }
        }

        .alert-item { display:flex; align-items:center; gap:12px; padding:12px 16px; border-bottom:1px solid var(--border); transition:background .15s; }
        .alert-item:last-child { border-bottom:none; }
        .alert-item:hover { background:rgba(248,81,73,.04); }
        .alert-days { width:42px; text-align:center; flex-shrink:0; font-family:'Rajdhani',sans-serif; font-size:22px; font-weight:700; color:#f85149; line-height:1; }
        .alert-days .dl { font-family:'Nunito',sans-serif; font-size:9px; text-transform:uppercase; letter-spacing:1px; color:var(--text-sec); }
        .alert-info .an { font-size:13px; font-weight:600; color:var(--text-pri); }
        .alert-info .am { font-size:11px; color:var(--text-sec); margin-top:2px; }

        @@keyframes fadeUp {
            from { opacity:0; transform:translateY(16px) scale(.97); }
            to   { opacity:1; transform:translateY(0)    scale(1);   }
        }
        .sc:nth-child(1){animation-delay:.04s} .sc:nth-child(2){animation-delay:.09s}
        .sc:nth-child(3){animation-delay:.14s} .sc:nth-child(4){animation-delay:.19s}
        .sc:nth-child(5){animation-delay:.24s} .sc:nth-child(6){animation-delay:.29s}
        .sc:nth-child(7){animation-delay:.34s} .sc:nth-child(8){animation-delay:.39s}
        .sc:nth-child(9){animation-delay:.44s} .sc:nth-child(10){animation-delay:.49s}
        .sc:nth-child(11){animation-delay:.54s}
    </style>
}

<!-- WELCOME BANNER -->
<div class="welcome-banner">
    <div class="wb-left">
        <h2><span data-i18n="dash.hello">Hello,</span> <span>@username</span> 👋</h2>
        <p data-i18n="dash.overview">Here's your Brick Factory overview</p>
    </div>
    <div class="wb-chips">
        <div class="wb-chip">🕐 <strong>@DateTime.Now.ToString("hh:mm tt")</strong></div>
        <div class="wb-chip">🏭 <strong style="color:#22d3a4;" data-i18n="dash.factoryActive">Factory Active</strong></div>
    </div>
</div>

<!-- STAT CARDS -->
<div class="stat-grid">
    <div class="sc c1">
        <div class="sc-icon">🏪</div>
        <div class="sc-val">@ViewBag.VendorCount</div>
        <div class="sc-lbl" data-i18n="dash.vendors">Vendors</div>
        <a class="sc-link" href="/Vendor/Index" data-i18n="dash.manage">Manage →</a>
    </div>
    <div class="sc c2">
        <div class="sc-icon">📦</div>
        <div class="sc-val">@ViewBag.MaterialCount</div>
        <div class="sc-lbl" data-i18n="dash.materialTypes">Material Types</div>
        <a class="sc-link" href="/Material/Index" data-i18n="dash.viewAll">View All →</a>
    </div>
    <div class="sc c3">
        <div class="sc-icon">👷</div>
        <div class="sc-val">@ViewBag.LabourCount</div>
