<!-- ROW 1: Recent Sales + Recent Purchases -->
<div class="two-col">

    <!-- Recent Brick Sales -->
    <div>
        <div class="sec-hdr">
            <h3><span>🧱</span> <span data-i18n="dash.recentSales">Recent Brick Sales</span></h3>
            <a href="/BrickSales/Index" data-i18n="dash.viewAll">View All →</a>
        </div>
        <div class="panel">
            <div class="tbl-scroll">
            <table class="dtbl">
                <thead>
                    <tr>
                        <th data-i18n="dash.col.customer">Customer</th>
                        <th data-i18n="dash.col.bricksQty">Qty</th>
                        <th data-i18n="dash.col.rate">Rate</th>
                        <th data-i18n="dash.col.amount">Amount</th>
                        <th data-i18n="dash.col.status">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in (IEnumerable<dynamic>)ViewBag.RecentSales)
                    {
                        string cname = (string)(s.CustomerName ?? "—");
                        var initials = string.Join("", cname.Split(' ').Take(2).Select(w => w.Length > 0 ? w[0].ToString() : "")).ToUpper();
                        decimal pending = (decimal)(s.PendingAmount ?? 0);
                        decimal paid    = (decimal)(s.PaidAmount ?? 0);
                        string sc = pending == 0 ? "bdg-paid" : (paid > 0 ? "bdg-pending" : "bdg-unpaid");
                        string st = pending == 0 ? "Paid"     : (paid > 0 ? "Partial"     : "Pending");
                        string ac = pending == 0 ? "#22d3a4"  : (paid > 0 ? "#f5c542"     : "#f85149");
                        <tr>
                            <td><div class="name-cell"><div class="av">@initials</div><span>@cname</span></div></td>
                            <td>@(((int)(s.Quantity ?? 0)).ToString("N0"))</td>
                            <td class="amt">₹@(((decimal)(s.Rate ?? 0)).ToString("N2"))</td>
                            <td class="amt" style="color:@ac;font-weight:700;">₹@(((decimal)(s.TotalAmount ?? 0)).ToString("N2"))</td>
                            <td><span class="bdg @sc">@st</span></td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
    </div>

    <!-- Recent Material Purchases -->
    <div>
        <div class="sec-hdr">
            <h3><span>🛒</span> <span data-i18n="dash.recentPurchases">Recent Material Purchases</span></h3>
            <a href="/MaterialPurchase/Index" data-i18n="dash.viewAll">View All →</a>
        </div>
        <div class="panel">
            <div class="tbl-scroll">
            <table class="dtbl">
                <thead>
                    <tr>
                        <th data-i18n="dash.col.vendor">Vendor</th>
                        <th data-i18n="dash.col.material">Material</th>
                        <th data-i18n="dash.col.qty">Qty</th>
                        <th data-i18n="dash.col.amount">Amount</th>
                        <th data-i18n="dash.col.status">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in (IEnumerable<dynamic>)ViewBag.RecentPurchases)
                    {
                        string vname = (string)(p.VendorName ?? "—");
                        var vi = string.Join("", vname.Split(' ').Take(2).Select(w => w.Length > 0 ? w[0].ToString() : "")).ToUpper();
                        decimal ppend = (decimal)(p.PendingAmount ?? 0);
                        decimal ppaid = (decimal)(p.PaidAmount ?? 0);
                        string ps = ppend == 0 ? "bdg-paid" : (ppaid > 0 ? "bdg-pending" : "bdg-unpaid");
                        string pt = ppend == 0 ? "Paid"     : (ppaid > 0 ? "Partial"     : "Due");
                        <tr>
                            <td><div class="name-cell"><div class="av">@vi</div><span>@vname</span></div></td>
                            <td>@((string)(p.MaterialName ?? "—"))</td>
                            <td>@(((decimal)(p.Quantity ?? 0)).ToString("N0"))</td>
                            <td class="amt" style="color:#e07b39;font-weight:700;">₹@(((decimal)(p.TotalAmount ?? 0)).ToString("N2"))</td>
                            <td><span class="bdg @ps">@pt</span></td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
    </div>
</div>

<!-- ROW 2: Labour + Production + Pending Dues -->
<div class="three-col" style="margin-top:22px;">

    <!-- Labour Overview + Advance Summary -->
    <div>
        <div class="sec-hdr">
            <h3><span>👷</span> <span data-i18n="dash.labourOverview">Labour Overview</span></h3>
            <a href="/LabourMaster/Index" data-i18n="common.all">All →</a>
        </div>
        <div class="panel">
            <div class="qlist">
                @foreach (var l in (IEnumerable<dynamic>)ViewBag.RecentLabour)
                {
                    string lname = (string)(l.LabourName ?? "—");
                    var li = string.Join("", lname.Split(' ').Take(2).Select(w => w.Length > 0 ? w[0].ToString() : "")).ToUpper();
                    DateOnly? jd = (DateOnly?)l.JoiningDate;
                    int yrs = jd.HasValue ? (int)((DateTime.Today - jd.Value.ToDateTime(TimeOnly.MinValue)).TotalDays / 365) : 0;
                    <div class="qlist-item">
                        <div class="qlist-left">
                            <div class="av" style="border-radius:8px;">@li</div>
                            <div>
                                <div>@lname</div>
                                <div class="qlist-sub">₹@(((decimal)(l.DailyWage ?? 0)).ToString("N0"))/day · @yrs yr@(yrs != 1 ? "s" : "")</div>
                            </div>
                        </div>
                        <span class="bdg bdg-active" data-i18n="dash.badge.active">Active</span>
                    </div>
                }
            </div>
        </div>

        <div class="sec-hdr" style="margin-top:18px;">
            <h3><span>💰</span> <span data-i18n="dash.advanceSummary">Advance Summary</span></h3>
            <a href="/LabourAdvance/Index" data-i18n="common.details">Details →</a>
        </div>
        <div class="panel">
            <div class="qlist">
                <div class="qlist-item">
                    <div class="qlist-left">
                        <div class="qlist-icon" style="background:rgba(248,81,73,.1);">💸</div>
                        <div><div data-i18n="dash.totalAdvances">Total Advances Given</div><div class="qlist-sub" data-i18n="dash.thisMonth">This month</div></div>
                    </div>
                    <strong style="color:#f85149;">₹@(((decimal)ViewBag.TotalAdvancesThisMonth).ToString("N0"))</strong>
                </div>
                <div class="qlist-item">
                    <div class="qlist-left">
                        <div class="qlist-icon" style="background:rgba(34,211,164,.1);">✅</div>
                        <div><div data-i18n="dash.deductionsDone">Deductions Done</div><div class="qlist-sub" data-i18n="dash.recovered">Recovered</div></div>
                    </div>
                    <strong style="color:#22d3a4;">₹@(((decimal)ViewBag.TotalDeductionsThisMonth).ToString("N0"))</strong>
                </div>
                <div class="qlist-item">
                    <div class="qlist-left">
                        <div class="qlist-icon" style="background:rgba(245,197,66,.1);">⏳</div>
                        <div><div data-i18n="dash.outstanding">Outstanding Balance</div><div class="qlist-sub" data-i18n="dash.pendingRecovery">Pending recovery</div></div>
                    </div>
                    <strong style="color:#f5c542;">₹@(((decimal)ViewBag.OutstandingAdvance).ToString("N0"))</strong>
                </div>
            </div>
        </div>
    </div>

    <!-- Production + Salary -->
    <div>
        <div class="sec-hdr">
            <h3><span>🏭</span> <span data-i18n="dash.productionWeek">Production (Recent)</span></h3>
            <a href="/BrickProduction/Index" data-i18n="common.all">All →</a>
        </div>
        <div class="panel">
            <div class="tbl-scroll">
            <table class="dtbl">
                <thead>
                    <tr>
                        <th data-i18n="dash.col.date">Date</th>
                        <th data-i18n="dash.col.rawBricks">Quantity</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var prod in (IEnumerable<dynamic>)ViewBag.RecentProduction)
                    {
                        DateOnly prodDate = (DateOnly)prod.Date;
                        string dateLabel = prodDate == today ? "Today"
                                         : prodDate == today.AddDays(-1) ? "Yesterday"
                                         : prodDate.ToString("dd MMM yyyy");
                        <tr>
                            <td>@dateLabel</td>
                            <td style="color:#e07b39;font-weight:700;">@(((int)(prod.Quantity ?? 0)).ToString("N0"))</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>

        <div class="sec-hdr" style="margin-top:18px;">
            <h3><span>💳</span> <span data-i18n="dash.salaryStatus">Salary Status</span></h3>
            <a href="/SalaryPayment/Index" data-i18n="common.details">Details →</a>
        </div>
        <div class="panel">
            <div class="qlist">
                <div class="qlist-item">
                    <div class="qlist-left">
                        <div class="qlist-icon" style="background:rgba(34,211,164,.1);">✅</div>
                        <div>
                            <div data-i18n="dash.salaryPaid">Salary Paid</div>
                            <div class="qlist-sub">@ViewBag.SalaryPaidCount workers this month</div>
                        </div>
                    </div>
                    <span class="bdg bdg-paid" data-i18n="dash.badge.done">Done</span>
                </div>
                <div class="qlist-item">
                    <div class="qlist-left">
                        <div class="qlist-icon" style="background:rgba(245,197,66,.1);">⏳</div>
                        <div>
                            <div data-i18n="dash.pendingSalary">Pending Salary</div>
                            <div class="qlist-sub">@ViewBag.SalaryPendingCount workers this month</div>
                        </div>
                    </div>
                    <span class="bdg bdg-pending" data-i18n="common.pending">Pending</span>
                </div>
                <div class="qlist-item">
                    <div class="qlist-left">
                        <div class="qlist-icon" style="background:rgba(224,123,57,.1);">💸</div>
                        <div><div data-i18n="dash.totalPaidOut">Total Paid Out</div><div class="qlist-sub" data-i18n="dash.thisMonth">This month</div></div>
                    </div>
                    <strong style="color:#e07b39;">₹@(((decimal)ViewBag.TotalSalaryPaidOut).ToString("N0"))</strong>
                </div>
            </div>
        </div>
    </div>

    <!-- Pending Customer Dues -->
    <div>
        <div class="sec-hdr">
            <h3><span>⚠️</span> <span data-i18n="dash.pendingDues">Pending Customer Dues</span></h3>
            <a href="/PendingPaymentReport/Index" data-i18n="common.all">All →</a>
        </div>
        <div class="panel">
            <div class="qlist">
                @{
                    var dues = (IEnumerable<Brick_Manufacturing_Management_System.Models.PendingPaymentsVM>)ViewBag.PendingDues;
                }
                @if (!dues.Any())
                {
                    <div style="text-align:center;padding:28px;color:var(--text-sec);font-size:13px;">
                        🎉 No outstanding dues!
                    </div>
                }
                else
                {
                    @foreach (var d in dues)
                    {
                        string badgeClass = d.PaymentStatus == "Partial" ? "bdg-pending" : "bdg-unpaid";
                        <div class="alert-item">
                            <div class="alert-info" style="flex:1;">
                                <div class="an">@d.CustomerName</div>
                                <div class="am">Total ₹@d.FinalAmount.ToString("N0") · Due ₹@d.RemainingAmount.ToString("N0")</div>
                            </div>
                            <span class="bdg @badgeClass" style="margin-left:auto;">@d.PaymentStatus</span>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        /* Auto-shrink long stat values so they never overflow the card */
        document.querySelectorAll('.sc-val').forEach(function(el) {
            var len = el.textContent.trim().length;
            if (len > 10) el.classList.add('val-xs');
            else if (len > 7) el.classList.add('val-sm');
        });

        /* Double-click anywhere on a stat card → navigate to its link.
           The existing single-click "Review →" link keeps working unchanged. */
        document.querySelectorAll('.sc').forEach(function(card) {
            var link = card.querySelector('.sc-link');
            if (!link) return;
            card.addEventListener('dblclick', function(e) {
                /* If the actual link was double-clicked, let it behave normally */
                if (e.target.closest('.sc-link')) return;
                window.location.href = link.href;
            });
        });
    </script>
}
