        <a class="sc-link" href="/LabourMaster/Index" data-i18n="dash.viewAll">View All →</a>
    </div>
@*     <div class="sc c4">
        <div class="sc-icon">🏭</div>
        <div class="sc-val">@(((decimal)ViewBag.BricksToday).ToString("N0"))</div>
        <div class="sc-lbl" data-i18n="dash.bricksToday">Bricks Today</div>
        <a class="sc-link" href="/BrickProduction/Index" data-i18n="dash.production">Production →</a>
    </div> *@
    <div class="sc c5">
        <div class="sc-icon">👥</div>
        <div class="sc-val">@ViewBag.CustomerCount</div>
        <div class="sc-lbl" data-i18n="dash.customers">Customers</div>
        <a class="sc-link" href="/CustomerMaster/Index" data-i18n="dash.viewAll">View All →</a>
    </div>
 @*    <div class="sc c7">
        <div class="sc-icon">💰</div>
        <div class="sc-val">@ViewBag.LabourLedgerCount</div>
        <div class="sc-lbl" data-i18n="dash.LabourLedgerReport">Labour Ledger Report</div>
        <a class="sc-link" href="/LabourLedgerReport/Index" data-i18n="dash.report">Report →</a>
    </div> *@
    <div class="sc c8">
        <div class="sc-icon">🕒</div>
        <div class="sc-val">₹@(((decimal)ViewBag.PendingPayments).ToString("N0"))</div>
        <div class="sc-lbl" data-i18n="dash.pendingPayments"> Customer Pending Payments</div>
        <a class="sc-link" href="/PendingPaymentReport/Index" data-i18n="dash.review">Review →</a>
    </div>
    <div class="sc c8">
