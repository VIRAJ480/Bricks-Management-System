@model Brick_Manufacturing_Management_System.Models.VendorVM
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Vendor Master";
    bool isEdit = Model.VendorId > 0;
    bool formOn = Model.Status ?? true;
    int total = Model.VendorList.Count;
    int active = Model.VendorList.Count(v => v.Status ?? false);
    int inactive = total - active;

    int pageSize = 5;
    int pageCount = (int)Math.Ceiling((double)total / pageSize);
}

@section Styles {
    <style>

        .vendor-page-wrap {
            display: flex;
            flex-direction: column;
            height: calc(100vh - var(--topbar-h) - 48px);
            gap: 0;
        }

        /* ── TOP CHIPS BAR ── */
        .vchips {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 10px;
            padding-bottom: 14px;
            flex-shrink: 0;
        }

        .vchips-left {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .vchip {
            display: flex;
            align-items: center;
            gap: 6px;
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 5px 14px;
            font-size: 12px;
            color: var(--text-sec);
        }

            .vchip strong {
                font-family: 'Rajdhani', sans-serif;
                font-size: 16px;
                color: var(--text-pri);
            }

        .page-ttl {
            font-family: 'Rajdhani', sans-serif;
            font-size: 22px;
            font-weight: 700;
            color: var(--text-pri);
            letter-spacing: 1px;
        }

        /* ── SPLIT CONTAINER ── */
        .split-wrap {
            display: flex;
            gap: 0;
            flex: 1;
            overflow: hidden;
            border: 1px solid var(--border);
            border-radius: 12px;
            background: var(--bg-card);
        }

        /* ── LEFT FORM PANEL ── */
        .form-side {
            width: 300px;
            flex-shrink: 0;
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .fs-header {
            padding: 14px 16px;
            border-bottom: 1px solid var(--border);
            font-family: 'Rajdhani', sans-serif;
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 1px;
            display: flex;
            align-items: center;
            gap: 7px;
            flex-shrink: 0;
            background: rgba(224,123,57,.05);
        }

            .fs-header.edit-hdr {
                color: #60a5fa;
            }

            .fs-header.add-hdr {
                color: var(--accent);
            }

        .fs-body {
            flex: 1;
            overflow-y: auto;
            padding: 14px 16px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            scrollbar-width: thin;
        }

        .fs-footer {
            padding: 13px 16px;
            border-top: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            gap: 8px;
            flex-shrink: 0;
        }

        /* FORM FIELDS */
        .fg {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

            .fg label {
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 1.5px;
                text-transform: none;
                color: var(--text-sec);
            }

            .fg input, .fg textarea {
                background: rgba(0,0,0,.3);
                border: 1px solid var(--border);
                border-radius: 7px;
                padding: 8px 11px;
                font-size: 12px;
                color: var(--text-pri);
                font-family: 'Nunito', sans-serif;
                outline: none;
                transition: border-color .2s;
                width: 100%;
            }

                .fg input:focus, .fg textarea:focus {
                    border-color: var(--accent);
                }

            .fg textarea {
                resize: vertical;
                min-height: 54px;
            }

            .fg .verr {
                font-size: 10px;
                color: #f85149;
                display: none;
                margin-top: 2px;
            }

                .fg .verr.show {
                    display: block;
                }

            .fg input.err-field {
                border-color: #f85149 !important;
            }

        /* STATUS TOGGLE */
        .srow {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-top: 2px;
        }

        .stog {
            position: relative;
            width: 40px;
            height: 22px;
            background: #2a2a2a;
            border-radius: 999px;
            cursor: pointer;
            border: 1px solid var(--border);
            transition: background .25s;
            flex-shrink: 0;
        }

            .stog.on {
                background: rgba(34,211,164,.45);
                border-color: rgba(34,211,164,.4);
            }

            .stog::after {
                content: '';
                position: absolute;
                top: 2px;
                left: 2px;
                width: 16px;
                height: 16px;
                border-radius: 50%;
                background: #666;
                transition: transform .25s, background .25s;
            }

            .stog.on::after {
                transform: translateX(18px);
                background: #22d3a4;
            }

        #statusLabel {
            font-size: 12px;
            font-weight: 600;
            transition: color .2s;
        }

        /* FORM BUTTONS */
        .btn-submit {
            width: 100%;
            padding: 10px;
            border-radius: 8px;
            border: none;
            cursor: pointer;
            font-size: 13px;
            font-weight: 700;
            font-family: 'Nunito', sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            transition: background .2s, transform .15s;
        }

            .btn-submit:active {
                transform: scale(.98);
            }

        .btn-add-mode {
            background: var(--accent);
            color: #fff;
        }

            .btn-add-mode:hover {
                background: #c96a28;
            }

        .btn-edit-mode {
            background: rgba(96,165,250,.2);
            color: #60a5fa;
            border: 1px solid rgba(96,165,250,.3) !important;
        }

            .btn-edit-mode:hover {
                background: rgba(96,165,250,.32);
            }

        .btn-reset {
            width: 100%;
            padding: 8px;
            border-radius: 8px;
            cursor: pointer;
            background: transparent;
            color: var(--text-sec);
            font-size: 12px;
            font-weight: 600;
            font-family: 'Nunito', sans-serif;
            border: 1px solid var(--border);
            transition: all .2s;
            text-align: center;
            text-decoration: none;
            display: block;
        }

            .btn-reset:hover {
                border-color: var(--accent);
                color: var(--accent);
            }

        /* ── RIGHT TABLE PANEL ── */
        .table-side {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .ts-header {
            padding: 11px 14px;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-shrink: 0;
            background: rgba(224,123,57,.04);
            gap: 10px;
            flex-wrap: wrap;
        }

        .ts-title {
            font-family: 'Rajdhani', sans-serif;
            font-size: 14px;
            font-weight: 700;
            letter-spacing: .5px;
            color: var(--text-pri);
        }

        .search-wrap {
            position: relative;
        }

            .search-wrap input {
                background: rgba(0,0,0,.25);
                border: 1px solid var(--border);
                border-radius: 7px;
                padding: 7px 12px 7px 30px;
                font-size: 12px;
                color: var(--text-pri);
                font-family: 'Nunito', sans-serif;
                width: 210px;
                outline: none;
                transition: border-color .2s;
            }

                .search-wrap input:focus {
                    border-color: var(--accent);
                }

        .search-si {
            position: absolute;
            left: 9px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 12px;
            color: var(--text-sec);
        }

        /* Table scroll area */
        .ts-body {
            flex: 1;
            overflow-y: auto;
            overflow-x: auto;
            scrollbar-width: thin;
            scrollbar-color: var(--border) transparent;
        }

            .ts-body::-webkit-scrollbar {
                width: 4px;
                height: 6px;
            }

            .ts-body::-webkit-scrollbar-thumb {
                background: var(--border);
                border-radius: 3px;
            }

                .ts-body::-webkit-scrollbar-thumb:hover {
                    background: var(--accent);
                }

        /* TABLE */
        .vtbl {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
            min-width: 680px;
        }

            .vtbl thead th {
                padding: 10px 12px;
                text-align: left;
                font-size: 9px;
                letter-spacing: 1.5px;
                text-transform: uppercase;
                color: var(--text-sec);
                font-weight: 700;
                border-bottom: 1px solid var(--border);
                background: var(--bg-card);
                white-space: nowrap;
                position: sticky;
                top: 0;
                z-index: 2;
            }

            .vtbl td {
                padding: 10px 12px;
                border-bottom: 1px solid var(--border);
                color: var(--text-pri);
                vertical-align: middle;
            }

            .vtbl tbody tr:last-child td {
                border-bottom: none;
            }

            .vtbl tbody tr:hover td {
                background: rgba(224,123,57,.04);
            }

            .vtbl tbody tr.editing-row td {
                background: rgba(96,165,250,.06);
            }

            .vtbl tbody tr.hidden-row {
                display: none;
            }

        /* AVATAR */
        .av {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: linear-gradient(135deg,#e07b39,#7c3510);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            font-weight: 700;
            color: #fff;
            flex-shrink: 0;
        }

        .name-cell {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* BADGES */
        .bdg {
            display: inline-flex;
            align-items: center;
            padding: 2px 8px;
            border-radius: 99px;
            font-size: 10px;
            font-weight: 700;
        }

        .bdg-active {
            background: rgba(34,211,164,.14);
            color: #22d3a4;
        }

        .bdg-inactive {
            background: rgba(248,81,73,.14);
            color: #f85149;
        }

        /* INLINE ROW TOGGLE */
        .row-toggle {
            position: relative;
            width: 32px;
            height: 18px;
            background: #2a2a2a;
            border-radius: 999px;
            cursor: pointer;
            border: 1px solid var(--border);
            transition: background .25s;
            flex-shrink: 0;
        }

            .row-toggle.on {
                background: rgba(34,211,164,.45);
                border-color: rgba(34,211,164,.4);
            }

            .row-toggle::after {
                content: '';
                position: absolute;
                top: 2px;
                left: 2px;
                width: 12px;
                height: 12px;
                border-radius: 50%;
                background: #666;
                transition: transform .25s, background .25s;
            }

            .row-toggle.on::after {
                transform: translateX(14px);
                background: #22d3a4;
            }

        .status-cell {
            display: flex;
            align-items: center;
            gap: 7px;
        }

        /* ACTION BUTTONS */
        .act {
            display: flex;
            gap: 5px;
        }

        .abtn {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 10px;
            font-weight: 700;
            border: none;
            cursor: pointer;
            font-family: 'Nunito', sans-serif;
            transition: background .2s;
            text-decoration: none;
        }

        .abtn-edit {
            background: rgba(96,165,250,.12);
            color: #60a5fa;
            border: 1px solid rgba(96,165,250,.2) !important;
        }

            .abtn-edit:hover {
                background: rgba(96,165,250,.25);
            }

        .abtn-del {
            background: rgba(248,81,73,.10);
            color: #f85149;
            border: 1px solid rgba(248,81,73,.2) !important;
        }

            .abtn-del:hover {
                background: rgba(248,81,73,.25);
            }

        /* EMPTY / NO-SEARCH */
        .empty-tbl {
            text-align: center;
            padding: 50px 20px;
            color: var(--text-sec);
            font-size: 13px;
        }

        #noSearch {
            display: none;
            text-align: center;
            padding: 28px;
            color: var(--text-sec);
            font-size: 12px;
        }

        /* ══ PAGINATION ══ */
        .ts-pagination {
            padding: 10px 14px;
            border-top: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-shrink: 0;
            flex-wrap: wrap;
            gap: 8px;
            background: rgba(224,123,57,.02);
        }

        .pg-info {
            font-size: 11px;
            color: var(--text-sec);
        }

            .pg-info span {
                color: var(--text-pri);
                font-weight: 700;
            }

        .pg-btns {
            display: flex;
            align-items: center;
            gap: 4px;
            flex-wrap: wrap;
        }

        .pg-btn {
            min-width: 30px;
            height: 30px;
            border-radius: 7px;
            border: 1px solid var(--border);
            background: transparent;
            color: var(--text-sec);
            font-size: 12px;
            font-weight: 600;
            font-family: 'Nunito', sans-serif;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            transition: all .18s;
            padding: 0 7px;
        }

            .pg-btn:hover:not(:disabled):not(.pg-dots) {
                border-color: var(--accent);
                color: var(--accent);
                background: rgba(224,123,57,.07);
            }

            .pg-btn.active {
                background: var(--accent);
                color: #fff;
                border-color: var(--accent);
                font-weight: 700;
                box-shadow: 0 2px 8px rgba(224,123,57,.4);
            }

            .pg-btn:disabled {
                opacity: .3;
                cursor: not-allowed;
            }

            .pg-btn.pg-dots {
                border-color: transparent;
                cursor: default;
                color: var(--text-sec);
                letter-spacing: 1px;
            }

        .pg-size-wrap {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 11px;
            color: var(--text-sec);
        }

            .pg-size-wrap select {
                background: rgba(255,255,255,.04);
                border: 1px solid var(--border);
                border-radius: 6px;
                color: var(--text-pri);
                font-size: 11px;
                font-family: 'Nunito', sans-serif;
                padding: 4px 8px;
                outline: none;
                cursor: pointer;
                -webkit-appearance: none;
                appearance: none;
            }

                .pg-size-wrap select:focus {
                    border-color: var(--accent);
                }

        /* DELETE MODAL */
        .del-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.65);
            z-index: 500;
            align-items: center;
            justify-content: center;
        }

            .del-overlay.show {
                display: flex;
            }

        .del-box {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 26px;
            width: 360px;
            max-width: 90vw;
            animation: popIn .22s ease;
        }

        @@keyframes popIn {
            from {
                transform: scale(.9);
                opacity: 0;
            }

            to {
                transform: scale(1);
                opacity: 1;
            }
        }

        .del-box h3 {
            font-family: 'Rajdhani',sans-serif;
            font-size: 20px;
            color: #f85149;
            margin-bottom: 8px;
        }

        .del-box p {
            font-size: 12px;
            color: var(--text-sec);
            line-height: 1.6;
        }

        .del-footer {
            display: flex;
            gap: 8px;
            justify-content: flex-end;
            margin-top: 18px;
        }

        .btn-dc {
            padding: 8px 16px;
            border-radius: 7px;
            font-size: 12px;
            font-weight: 700;
            font-family: 'Nunito',sans-serif;
            cursor: pointer;
        }

        .btn-dc-cancel {
            background: rgba(255,255,255,.06);
            color: var(--text-sec);
            border: 1px solid var(--border);
        }

        .btn-dc-del {
            background: rgba(248,81,73,.14);
            color: #f85149;
            border: 1px solid rgba(248,81,73,.3);
            transition: background .2s;
        }

            .btn-dc-del:hover {
                background: rgba(248,81,73,.28);
            }

        .fs-body::-webkit-scrollbar {
            width: 4px;
        }

        .fs-body::-webkit-scrollbar-thumb {
            background: var(--border);
            border-radius: 2px;
        }

    </style>
}

<div class="vendor-page-wrap">

    <!-- TOP CHIPS -->
    <div class="vchips">
        <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;">
            <div class="page-ttl" data-i18n="nav.vendorMaster">🏪 Vendor Master</div>
            <div class="vchips-left">
                <div class="vchip"><span data-i18n="common.total">Total</span> <strong>@total</strong></div>
                <div class="vchip">✅ <span data-i18n="common.active">Active</span> <strong style="color:#22d3a4;">@active</strong></div>
                <div class="vchip">⛔ <span data-i18n="common.inactive">Inactive</span> <strong style="color:#f85149;">@inactive</strong></div>
            </div>
        </div>
        <div style="font-size:11px;color:var(--text-sec);">@DateTime.Now.ToString("dddd, dd MMM yyyy")</div>
    </div>

    <!-- SPLIT LAYOUT -->
    <div class="split-wrap">    

        <!-- ══ LEFT: FORM ══ -->
        <aside class="form-side">
            <div class="fs-header @(isEdit ? "edit-hdr" : "add-hdr")">
                @(isEdit ? "✏️" : "🏪") <span data-i18n='@(isEdit ? "vendor.editVendor" : "vendor.addVendor")'>@(isEdit ? "Edit Vendor" : "Add Vendor")</span>
            </div>

            <form asp-action="Save" method="post" novalidate id="vendorForm">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="VendorId" />

                <div class="fs-body">

                    <div class="fg">
                        <label data-i18n="vendor.vendorName">Vendor Name *</label>
                        <input asp-for="VendorName"
                               placeholder="e.g. Arjun Enterprises" autocomplete="off"
                               class="@(ViewData.ModelState["VendorName"]?.Errors.Count > 0 ? "err-field" : "")" />
                        <span asp-validation-for="VendorName" class="verr show"></span>
                    </div>

                    <div class="fg">
                        <label data-i18n="form.mobileNumber">Mobile Number</label>
                        <input asp-for="MobileNumber"
                               placeholder="9876543210" maxlength="15"
                               class="@(ViewData.ModelState["MobileNumber"]?.Errors.Count > 0 ? "err-field" : "")" />
                        <span asp-validation-for="MobileNumber" class="verr show"></span>
                    </div>

                    <div class="fg">
                        <label data-i18n="vendor.gstNumber">GST Number</label>
                        <input asp-for="GSTNumber"
                               placeholder="22ABCDE1234F1Z5" maxlength="20"
                               style="text-transform:uppercase;"
                               class="@(ViewData.ModelState["GSTNumber"]?.Errors.Count > 0 ? "err-field" : "")" />
                        <span asp-validation-for="GSTNumber" class="verr show"></span>
                    </div>

                    <div class="fg">
                        <label data-i18n="form.address">Address</label>
                        <textarea asp-for="Address" placeholder="Full vendor address…"></textarea>
                    </div>

                    <div class="fg">
                        <label data-i18n="form.status">Status</label>
                        <div class="srow">
                            <div class="stog @(formOn ? "on" : "")" id="statusToggle" onclick="toggleStatusForm()"></div>
                            <span id="statusLabel" style="color:@(formOn ? "#22d3a4" : "#f85149")">
                                @(formOn ? "Active" : "Inactive")
                            </span>
                            <input type="hidden" name="Status" id="statusInput" value="@formOn.ToString().ToLower()" />
                        </div>
                    </div>

                </div>

                <div class="fs-footer">
                    <button type="submit" class="btn-submit @(isEdit ? "btn-edit-mode" : "btn-add-mode")" data-i18n='@(isEdit ? "vendor.updateVendor" : "vendor.registerVendor")'>
                        @(isEdit ? "💾 Update Vendor" : "＋ Register Vendor")
                    </button>
                    @if (isEdit)
                    {
                        <a href="/Vendor/Index" class="btn-reset" data-i18n="common.cancelEdit">↺ Cancel Edit</a>
                    }
                    else
                    {
                        <button type="button" class="btn-reset" onclick="resetForm()" data-i18n="common.reset">↺ Reset</button>
                    }
                </div>
            </form>
        </aside>

        <!-- ══ RIGHT: TABLE ══ -->
        <section class="table-side">

            <div class="ts-header">
                <div class="ts-title" data-i18n="vendor.vendorList">Vendor List</div>
                <div class="search-wrap">
                    <span class="search-si">🔍</span>
                    <input type="text" id="searchInput" data-i18n-placeholder="form.searchNameMobile" placeholder="Search by name or mobile…" oninput="filterTable()" />
                </div>
            </div>

            <div class="ts-body">
                @if (!Model.VendorList.Any())
                {
                    <div class="empty-tbl">🏪 No vendors yet. Add your first vendor using the form.</div>
                }
                else
                {
                    <table class="vtbl" id="vendorTable">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th data-i18n="vendor.vendorCol">Vendor</th>
                                <th data-i18n="form.mobile">Mobile</th>
                                <th data-i18n="vendor.gstNumber">GST Number</th>
                                <th data-i18n="form.address">Address</th>
                                <th data-i18n="form.status">Status</th>
                                <th data-i18n="common.actions">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="vendorBody">
                            @foreach (var v in Model.VendorList)
                            {
                                var initials = string.Join("", v.VendorName.Split(' ').Take(2).Select(w => w[0])).ToUpper();
                                bool rowStatus = v.Status ?? false;
                                bool isEditing = Model.VendorId == v.VendorId;

                                <tr class="@(isEditing ? "editing-row" : "")"
                                    id="row-@v.VendorId"
                                    data-search="@v.VendorName.ToLower() @(v.MobileNumber ?? "")">
                                    <td style="color:var(--text-sec);font-size:11px;">@v.VendorId</td>
                                    <td>
                                        <div class="name-cell">
                                            <div class="av">@initials</div>
                                            <div style="font-weight:600;">@v.VendorName</div>
                                        </div>
                                    </td>
                                    <td>@(v.MobileNumber ?? "—")</td>
                                    <td style="font-family:monospace;font-size:11px;color:#a78bfa;">
                                        @(string.IsNullOrEmpty(v.Gstnumber) ? "—" : v.Gstnumber)
                                    </td>
                                    <td style="max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"
                                        title="@v.Address">
                                        @(string.IsNullOrEmpty(v.Address) ? "—" : v.Address)
                                    </td>
                                    <td>
                                        <div class="status-cell">
                                            <div class="row-toggle @(rowStatus ? "on" : "")"
                                                 id="tog-@v.VendorId"
                                                 onclick="toggleStatus(@v.VendorId, this)"></div>
                                            <span class="bdg @(rowStatus ? "bdg-active" : "bdg-inactive")"
                                                  id="lbl-@v.VendorId">
                                                @(rowStatus ? "Active" : "Inactive")
                                            </span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="act">
                                            <a href="/Vendor/Index?editId=@v.VendorId" class="abtn abtn-edit">✏ Edit</a>
                                            <button type="button" class="abtn abtn-del"
                                                    onclick="openDel(@v.VendorId, '@Html.Raw(v.VendorName.Replace("'", "\\'"))')">
                                                🗑 Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div id="noSearch">
                        <span style="font-size:22px;display:block;margin-bottom:8px;opacity:.4;">🔍</span>
                        No vendors match your search.
                    </div>
                }
            </div>

            <!-- ════ PAGINATION ════ -->
            @if (Model.VendorList.Any())
            {
                <div class="ts-pagination">
                    <div class="pg-info">
                        Showing <span id="pgFrom">1</span>–<span id="pgTo">@Math.Min(pageSize, total)</span>
                        of <span id="pgTotal">@total</span> vendors
                    </div>
                    <div class="pg-btns" id="pgBtns"></div>
                    <div class="pg-size-wrap">
                        Rows:
                        <select id="pgSizeSelect" onchange="changePageSize(+this.value)">
                            <option value="5" selected>5</option>
                            <option value="8">8</option>
                            <option value="15">15</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                        </select>
                    </div>
                </div>
            }

        </section>

    </div>
</div>

<!-- DELETE MODAL -->
<div class="del-overlay" id="delOverlay">
    <div class="del-box">
        <h3 data-i18n="vendor.deleteTitle">⚠️ Delete Vendor?</h3>
        <p>
            You are about to permanently delete
            <strong id="delVendorName" style="color:var(--accent);"></strong>.<br>
            This action cannot be undone.
        </p>
        <div class="del-footer">
            <button type="button" class="btn-dc btn-dc-cancel" onclick="closeDel()" data-i18n="common.cancel">Cancel</button>
            <form id="delForm" method="post" style="margin:0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-dc btn-dc-del" data-i18n="common.yesDelete">Yes, Delete</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const TOTAL_ROWS = @total;
        let pageSize    = 5;
        let currentPage = 0;
        let isSearching = false;

        function getPageCount() { return Math.max(1, Math.ceil(TOTAL_ROWS / pageSize)); }

        function assignPages() {
            document.querySelectorAll('#vendorBody tr').forEach((r, i) => {
                r.dataset.page = Math.floor(i / pageSize);
            });
        }

        function renderPagination() {
            const pc  = getPageCount();
            const box = document.getElementById('pgBtns');
            box.innerHTML = '';
            function btn(label, page, cls) {
                const b = document.createElement('button');
                b.className = 'pg-btn' + (cls ? ' ' + cls : '');
                b.innerHTML = label;
                if (page !== null) b.onclick = () => changePage(page);
                else b.disabled = true;
                return b;
            }
            const prev = btn('&#8249;', currentPage - 1);
            prev.disabled = currentPage === 0;
            box.appendChild(prev);
            const show = new Set([0, pc - 1]);
            for (let i = Math.max(0, currentPage - 2); i <= Math.min(pc - 1, currentPage + 2); i++) show.add(i);
            let prev_p = -1;
            [...show].sort((a, b) => a - b).forEach(p => {
                if (p - prev_p > 1) box.appendChild(btn('…', null, 'pg-dots'));
                box.appendChild(btn(p + 1, p, p === currentPage ? 'active' : ''));
                prev_p = p;
            });
            const next = btn('&#8250;', currentPage + 1);
            next.disabled = currentPage >= pc - 1;
            box.appendChild(next);
        }

        function showPage(p) {
            currentPage = p;
            document.querySelectorAll('#vendorBody tr').forEach(r => {
                r.classList.toggle('hidden-row', parseInt(r.dataset.page) !== p);
            });
            document.getElementById('pgFrom').textContent  = p * pageSize + 1;
            document.getElementById('pgTo').textContent    = Math.min((p + 1) * pageSize, TOTAL_ROWS);
            document.getElementById('pgTotal').textContent = TOTAL_ROWS;
            renderPagination();
        }

        function changePage(p) {
            if (p < 0 || p >= getPageCount()) return;
            showPage(p);
        }

        function changePageSize(val) {
            pageSize = val; currentPage = 0;
            assignPages(); showPage(0);
        }

        assignPages();
        if (TOTAL_ROWS > 0) showPage(0);

        /* ── FORM STATUS TOGGLE ── */
        function toggleStatusForm() {
            const tog  = document.getElementById('statusToggle');
            const inp  = document.getElementById('statusInput');
            const lbl  = document.getElementById('statusLabel');
            const isOn = tog.classList.toggle('on');
            inp.value      = isOn ? 'true' : 'false';
            lbl.textContent = isOn ? 'Active' : 'Inactive';
            lbl.style.color = isOn ? '#22d3a4' : '#f85149';
        }

        /* ── Clear validation error as soon as user interacts with a field ── */
        document.querySelectorAll('#vendorForm input, #vendorForm select').forEach(function(el) {
            var evt = (el.tagName === 'SELECT' || el.type === 'date') ? 'change' : 'input';
            el.addEventListener(evt, function() {
                this.classList.remove('err-field');
                var fg = this.closest('.fg') || this.closest('.select-wrap')?.closest('.fg');
                if (fg) {
                    var errSpan = fg.querySelector('.verr');
                    if (errSpan) errSpan.classList.remove('show');
                }
            });
        });

        /* ── RESET FORM ── */
        function resetForm() {
            document.getElementById('vendorForm').reset();
            document.getElementById('statusToggle').classList.add('on');
            document.getElementById('statusInput').value = 'true';
            document.getElementById('statusLabel').textContent = 'Active';
            document.getElementById('statusLabel').style.color = '#22d3a4';
            document.querySelectorAll('.verr').forEach(e => e.classList.remove('show'));
            document.querySelectorAll('.err-field').forEach(e => e.classList.remove('err-field'));
        }

        /* ── SEARCH FILTER ── */
        function filterTable() {
            const q    = document.getElementById('searchInput').value.toLowerCase().trim();
            const rows = Array.from(document.querySelectorAll('#vendorBody tr'));
            isSearching = q.length > 0;
            if (!isSearching) {
                assignPages(); showPage(0);
                document.getElementById('noSearch').style.display = 'none';
                return;
            }
            let vis = 0;
            rows.forEach(r => {
                const match = ((r.dataset.search || '') + ' ' + r.textContent.toLowerCase()).includes(q);
                r.classList.toggle('hidden-row', !match);
                if (match) vis++;
            });
            document.getElementById('noSearch').style.display = vis === 0 ? 'block' : 'none';
            document.getElementById('pgFrom').textContent  = vis > 0 ? 1 : 0;
            document.getElementById('pgTo').textContent    = vis;
            document.getElementById('pgTotal').textContent = vis;
            document.getElementById('pgBtns').innerHTML    = '';
        }

        /* ── ROW STATUS TOGGLE (AJAX) ── */
        async function toggleStatus(id, el) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
            try {
                const res  = await fetch('/Vendor/ToggleStatus/' + id, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token }
                });
                const data = await res.json();
                if (data.success) {
                    el.classList.toggle('on', data.status);
                    const lbl = document.getElementById('lbl-' + id);
                    if (lbl) {
                        lbl.className   = 'bdg ' + (data.status ? 'bdg-active' : 'bdg-inactive');
                        lbl.textContent = data.status ? 'Active' : 'Inactive';
                    }
                }
            } catch (e) { console.error(e); }
        }

        /* ── DELETE MODAL ── */
        function openDel(id, name) {
            document.getElementById('delVendorName').textContent = name;
            document.getElementById('delForm').action = '/Vendor/Delete/' + id;
            document.getElementById('delOverlay').classList.add('show');
        }
        function closeDel() {
            document.getElementById('delOverlay').classList.remove('show');
        }
        document.getElementById('delOverlay').addEventListener('click', function(e) {
            if (e.target === this) closeDel();
        });

        /* ── SCROLL EDITING ROW INTO VIEW ── */
        const editRow = document.querySelector('.editing-row');
        if (editRow) {
            changePage(parseInt(editRow.dataset.page) || 0);
            setTimeout(() => editRow.scrollIntoView({ behavior: 'smooth', block: 'center' }), 100);
        }
    </script>
}
